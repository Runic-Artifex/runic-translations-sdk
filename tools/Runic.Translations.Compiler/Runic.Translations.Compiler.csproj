<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../eng/build/translations.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>Runic.Translations.Compiler</AssemblyName>
    <RootNamespace>Runic.Translations.Compiler</RootNamespace>
    <!-- Packed under lib/ of Runic.Translations.Tooling; its public API is tracked in PublicAPI.*.txt. -->
    <RunicTrackPublicApi>true</RunicTrackPublicApi>
    <Description>Pure deterministic compiler kernel for Runic Translations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Source-tree analyzer hosts resolve compiler dependencies from this output directory. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- These names deliberately mirror the normative serialized descriptor vocabulary. -->
    <NoWarn>$(NoWarn);CA1720</NoWarn>
    <!-- Selects the compiler namespace in the CLDR locale sources shared with the runtime. -->
    <DefineConstants>$(DefineConstants);RUNIC_TRANSLATIONS_COMPILER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generation/Rmf2EsmRuntimeV5.js" />
    <EmbeddedResource Include="Generation/Rmf2EsmTransportV5.js" />
    <EmbeddedResource Include="GeneratedFormatData.bin" LogicalName="Runic.Translations.Compiler.GeneratedFormatData.bin" />
    <!-- The pinned CLDR locale tables and algorithm are shared with the runtime (eng/generate-cldr.mjs). -->
    <Compile Include="../../packages/dotnet/Runic.Translations/Formatting/CldrLocales.cs" Link="Cldr/CldrLocales.cs" />
    <Compile Include="../../packages/dotnet/Runic.Translations/Formatting/GeneratedLocaleTables.cs" Link="Cldr/GeneratedLocaleTables.cs" />
    <EmbeddedResource Include="../../packages/dotnet/Runic.Translations/Formatting/GeneratedLocaleData.bin" LogicalName="Runic.Translations.Compiler.GeneratedLocaleData.bin" Link="Cldr/GeneratedLocaleData.bin" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\specs\translations\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\specs\translations\cldr\LICENSE" Pack="true" PackagePath="licenses" />
  </ItemGroup>
  <Import Project="../../eng/build/translations.targets" />
</Project>
