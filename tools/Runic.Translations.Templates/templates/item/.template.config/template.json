{
  "$schema": "http://json.schemastore.org/template",
  "author": "RunicArtifex",
  "classifications": [
    "Localization",
    "Resources",
    "Runic"
  ],
  "identity": "RunicArtifex.Translations.Item",
  "name": "Runic Translations files",
  "shortName": "runic-translations",
  "description": "Adds a minimal compiler-valid runic.json and RMF2 locale project containing MF2 messages.",
  "tags": {
    "language": "C#",
    "type": "item"
  },
  "preferNameDirectory": false,
  "symbols": {
    "catalog": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "product",
      "description": "Portable catalog identifier.",
      "replaces": "__CATALOG__",
      "fileRename": "_catalog_"
    },
    "defaultLocale": {
      "type": "parameter",
      "datatype": "string",
      "description": "Default BCP-47 locale tag. Default: en.",
      "defaultValue": "en",
      "replaces": "__DEFAULT_LOCALE__",
      "fileRename": "_defaultLocale_"
    },
    "locales": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Additional locale tags, comma-separated, such as de,fr. Add a translations/<locale>.rmf2 file for each; until then the build warns about untranslated messages."
    },
    "extraLocales": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "locales",
        "steps": [
          {
            "regex": "\\s*,\\s*",
            "replacement": "\", \""
          },
          {
            "regex": "^\\s*(.+?)\\s*$",
            "replacement": ", \"$1\""
          }
        ]
      },
      "replaces": "__EXTRA_LOCALES__"
    },
    "hasLocales": {
      "type": "computed",
      "value": "(locales != \"\")"
    },
    "namespace": {
      "type": "parameter",
      "datatype": "string",
      "description": "Namespace for generated C# APIs. Default: the name, as a namespace."
    },
    "nameNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "safe_namespace"
    },
    "namespaceValue": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "namespace",
        "fallbackVariableName": "nameNamespace"
      },
      "replaces": "__NAMESPACE__"
    },
    "className": {
      "type": "parameter",
      "datatype": "string",
      "description": "Class name for generated C# APIs. Default: ProductText.",
      "defaultValue": "ProductText",
      "replaces": "__CLASS_NAME__"
    }
  }
}
