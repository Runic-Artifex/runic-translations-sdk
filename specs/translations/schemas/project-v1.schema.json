{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/project-v1.schema.json",
  "title": "Runic Translations project v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalog",
    "code",
    "baseLocale"
  ],
  "properties": {
    "$schema": {
      "const": "https://runic-artifex.eu/schemas/translations/project-v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "namespace"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "catalog": {
      "$ref": "#/$defs/id"
    },
    "code": {
      "$ref": "#/$defs/code"
    },
    "baseLocale": {
      "$ref": "#/$defs/localeTag"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/localeTag"
          },
          {
            "$ref": "#/$defs/locale"
          }
        ]
      }
    },
    "pseudoLocales": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "en-XA",
          "ar-XB"
        ]
      },
      "description": "Development pseudo-locales generated from the base locale in Debug builds (MSBuild), in Vite modes other than production, and with --pseudo-locales: en-XA has accented, about 35% longer, bracketed text; ar-XB is right-to-left with mirrored text. Release builds leave them out. Do not also list them in locales."
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "markup": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "kind": {
                "enum": [
                  "paired",
                  "standalone"
                ]
              },
              "placement": {
                "enum": [
                  "inline"
                ]
              },
              "children": {
                "enum": [
                  "inline",
                  "none"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "plainText": {
                "enum": [
                  "children",
                  "lineBreak",
                  "alternateText",
                  "explicit",
                  "omit"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "enum"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "minimum": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "maximum": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "default": {
                      "type": "string"
                    },
                    "literalOnly": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "kind",
              "children",
              "interactive",
              "plainText"
            ],
            "additionalProperties": false
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4096
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "localeTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "locale": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/localeTag"
        },
        "fallback": {
          "$ref": "#/$defs/localeTag"
        }
      },
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "required": [
        "namespace",
        "className"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "className": {
          "$ref": "#/$defs/identifier"
        },
        "visibility": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "referenceFallbackText": {
          "type": "boolean",
          "default": true,
          "description": "Generated C# reference factories (Class.References) include the base-locale text as the reference's fallback text."
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "enum": [
        "allow",
        "warning",
        "error"
      ]
    },
    "validation": {
      "type": "object",
      "properties": {
        "translationCompleteness": {
          "$ref": "#/$defs/policy"
        },
        "extraLocaleKeys": {
          "$ref": "#/$defs/policy"
        },
        "emptyValues": {
          "$ref": "#/$defs/policy"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "unsupportedLocale": {
          "enum": [
            "exact",
            "parentsThenDefault",
            "default"
          ]
        },
        "missingKey": {
          "enum": [
            "throw",
            "returnKey",
            "returnMarker"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
