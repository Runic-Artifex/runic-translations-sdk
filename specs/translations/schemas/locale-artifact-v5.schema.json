{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/locale-artifact-v5.schema.json",
  "title": "Runic RMF2 resolved locale artifact v5",
  "type": "object",
  "required": [
    "artifactVersion",
    "messageGrammarVersion",
    "profile",
    "catalog",
    "locale",
    "contractFingerprint",
    "messages",
    "markupContract"
  ],
  "properties": {
    "artifactVersion": {
      "const": 5
    },
    "messageGrammarVersion": {
      "const": 5
    },
    "profile": {
      "const": "rmf2-execution-v2"
    },
    "catalog": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "contractFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "messages": {
      "type": "object",
      "maxProperties": 50000,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "contentLocale",
          "ast"
        ],
        "properties": {
          "contentLocale": {
            "type": "string",
            "minLength": 1
          },
          "ast": {
            "$ref": "message-ast-v5.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "markupContract": {
      "type": "object",
      "properties": {
        "version": {
          "const": 2
        },
        "contracts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "paired",
                  "standalone"
                ]
              },
              "placement": {
                "enum": [
                  "inline",
                  "block",
                  "list-item"
                ]
              },
              "children": {
                "enum": [
                  "inline",
                  "none",
                  "list-items"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "plainText": {
                "enum": [
                  "children",
                  "lineBreak",
                  "alternateText",
                  "explicit",
                  "omit"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "enum"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "minimum": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "maximum": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "default": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "literalOnly": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "type",
                    "values",
                    "default",
                    "literalOnly"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "kind",
              "placement",
              "children",
              "interactive",
              "plainText",
              "options"
            ],
            "additionalProperties": false
          }
        },
        "messages": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "slots": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "enum": [
                        "runic:link",
                        "runic:action",
                        "runic:icon"
                      ]
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4096
                    }
                  },
                  "required": [
                    "kind",
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                }
              },
              "structured": {
                "type": "boolean"
              },
              "contentLocales": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "content": {
                "enum": [
                  "inline",
                  "document"
                ]
              },
              "skeletons": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "slots",
              "structured",
              "contentLocales",
              "content",
              "skeletons"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "version",
        "contracts",
        "messages"
      ],
      "additionalProperties": false
    },
    "formatData": {
      "description": "The pinned CLDR data the messages need: number records when they format numbers, dates or times (numbers), and currency, unit and compact data when they use :currency, :unit or compact notation (the compiler's selection of specs/translations/cldr/runic-formats-48.2.json for the content locales' languages). Both runtimes check it with the rules of rmf2-execution-v2.md, Embedded format data, which are stricter than this schema.",
      "type": "object",
      "properties": {
        "currencies": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z]{3}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        },
        "dynamicCurrencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          }
        },
        "dynamicUnits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locales": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "currencyFormats": {
                "type": "object"
              },
              "currencies": {
                "type": "object"
              },
              "units": {
                "type": "object"
              },
              "per": {
                "type": "object"
              },
              "compact": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "numbers": {
          "description": "The number records of the artifact's languages, which both runtimes check before their own, and the CLDR likely subtags, parents and aliases that resolve their tags.",
          "type": "object",
          "properties": {
            "locales": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-[a-z0-9]{4,8})*$"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 13,
                "maxItems": 25
              }
            },
            "grouping": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?(?:-[a-z0-9]{4,8})*$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "likely": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              }
            },
            "parents": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              }
            },
            "aliases": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[A-Za-z0-9]{1,8}(?:-[A-Za-z0-9]{1,8})*$",
                "maxLength": 64
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "currencies": [
          "locales"
        ],
        "locales": [
          "currencies"
        ],
        "dynamicCurrencies": [
          "currencies",
          "locales"
        ],
        "dynamicUnits": [
          "currencies",
          "locales"
        ]
      }
    }
  },
  "additionalProperties": false
}
