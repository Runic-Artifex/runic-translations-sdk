  "optionErrors": {
    "unknown": "compile-error",
    "invalidLiteral": "compile-error",
    "undeclaredDynamicInput": "compile-error",
    "dynamicTypeMismatch": "compile-error",
    "invalidDynamicValue": "evaluation-error",
    "rangeHandling": "reject-never-clamp",
    "diagnostic": "RTR0065",
    "unknownCurrencyOrUnit": "compile-error RTR0101",
    "undeclaredDynamicCurrencyOrUnit": "compile-error RTR0102"
  },
  "numberConstraints": {
    "fractionDigits": "0 <= minimum <= maximum <= 6 (decimal) or 4 (percent)",
    "rounding": "halfExpand",
    "selectionUses": "visible-decimal",
    "visibleDecimal": "number functions multiply percent by 100, round halfExpand to maximumFractionDigits, then keep or pad trailing zeros to minimumFractionDigits; integer and relative-time use the canonical value"
  },
  "decimal": {
    "coefficientMaximum": "79228162514264337593543950335",
    "scaleMinimum": 0,
    "scaleMaximum": 28,
    "sourceLengthMaximum": 4096,
    "exponent": "signed-int32",
    "canonical": "plain decimal, no exponent, no leading plus or redundant zeros, negative zero becomes 0",
    "overflow": "reject",
    "underflow": "reject nonzero values outside the exact domain",
    "rounding": "none"
  },
  "grouping": {
    "option": "useGrouping on integer and number, as in Unicode MessageFormat 2 and Intl.NumberFormat",
    "never": "no separators; an integer formats invariantly",
    "always": "separators whenever the integer part is longer than the primary group",
    "auto": "separators once the integer part has at least the content locale family's CLDR minimumGroupingDigits digits above the primary group (1 unless pinned)",
    "min2": "as auto with at least 2 digits above the primary group",
    "symbols": "decimal, group and minus symbols, group sizes and digits come from the formatting locale's pinned CLDR number formats",
    "conformance": "corpus/rmf2-grouping-conformance.json"
  },
  "listFormat": {
    "patterns": "CLDR listPatterns of the content locale family: conjunction = standard, disjunction = or, unit = unit; long, short and narrow styles",
    "items": "strings inserted verbatim, in caller order, without sorting",
    "zeroItems": "empty string",
    "oneItem": "the item",
    "twoItems": "the 2 pattern",
    "moreItems": "start pattern for the first two items, middle pattern for each inner item, end pattern for the last item",
    "contextual": "es, case-insensitive: a y separator of the 2 or end pattern becomes e before a last item starting with i, or with hi not followed by a or e; otherwise an o separator becomes u before a last item starting with o, ho or 8, or equal to 11 or starting with 11 and a space (ICU)",
    "conformance": "corpus/rmf2-list-conformance.json"
  },
  "formattingLocale": {
    "rule": "numbers, percentages, dates and times format in the requested locale, without extensions and private-use subtags, when its language subtag equals the content locale's and both have the same implied script (the explicit script, else the pinned CLDR likely script of the language and region); otherwise in the content locale",
    "script": "an explicit script that is the likely script of the language and region is dropped for a language whose CLDR likely subtags for the language and its regions (the language-only and language-region keys) name one script only (de-Latn-CH formats as de-CH, en-Latn-US as en-US; sr-Cyrl-BA and zh-Hans-HK stay)",
    "numberingExtension": "-u-nu-latn is kept where the formatting locale's default numbering system is not latn; every other extension is dropped",
    "contentLocale": "plural, ordinal, list and relative-time patterns, and the locale reported on content, stay on the message's effective content locale; the number in relative time formats in the formatting locale, as :number does",
    "requested": "the canonical tag the caller asked for, before it was resolved to a catalog locale"
  },
  "bidi": {
    "strategy": "Unicode MessageFormat 2's default bidi strategy (LDML 48 Handling Bidirectional Text): with msgdir the direction of the message's content locale and dir the direction of a placeholder, a left-to-right placeholder stays bare when msgdir is left to right and its u:dir is absent or inherit, else it is wrapped in U+2066 LRI and U+2069 PDI; a right-to-left placeholder is wrapped in U+2067 RLI and PDI; one of unknown direction in U+2068 FSI and PDI",
    "isolation": "runtime.bidiIsolation in runic.json: on always, off never, and default per format call, when the requested locale, the catalog locale it resolved to or the message's content locale is right to left (default is not resolved at compile time, so right-to-left overlays and packs of left-to-right catalogs are isolated); an explicit u:dir of ltr, rtl or auto isolates its placeholder in every mode",
    "placeholderDirection": "u:dir ltr, rtl, auto (unknown) or inherit (msgdir), a literal only; without it, integer, number, date, time and datetime have the formatting locale's direction, runic:relative-time and runic:list the content locale's, runic:uuid and runic:boolean are left to right, and string is unknown; a functionless local alias keeps its u:dir and an explicit function replaces it",
    "listItems": "when isolation applies, each runic:list item is wrapped in U+2068 FSI and U+2069 PDI before the CLDR list pattern joins the items; contextual conjunction rules read the raw item",
    "localeDirection": "right to left when the explicit script, else the CLDR likely script of the tag, is one of CLDR's right-to-left scripts"
  },
  "numberFormat": {
    "source": "pinned CLDR 48.2 numbers of the formatting locale, along its CLDR parent chain; CLDR root without data",
    "numberingSystem": "defaultNumberingSystem, or latn with -u-nu-latn",
    "never": "useGrouping=never writes the locale's minus sign and digits without group separators, for :integer and :number alike",
    "zero": "a visible decimal of zero has no sign: -0.0001 with maximumFractionDigits=2 is 0 and -0.00001 as a percent is 0%, where Intl.NumberFormat writes -0 and -0%",
    "comparison": "corpus/localized-format-divergences.json"
  },
  "percent": {
    "pattern": "the formatting locale's pinned CLDR percent pattern in its numbering system, verbatim: prefix, digits and suffix; without a negative subpattern the minus sign precedes the positive prefix",
    "symbols": "the locale's pinned percent sign, minus sign and digits",
    "conformance": "corpus/rmf2-date-percent-conformance.json"
  },
  "dateTimeFormat": {
    "iso": "invariant: date yyyy-MM-dd, time HH:mm:ss, datetime UTC yyyy-MM-ddTHH:mm:ssZ; timeZone does not apply",
    "dateStyles": "short, medium, long and full are the CLDR date lengths of the formatting locale from platform globalization",
    "yearWidth": "a year is written in full, so short dates show the full year: a Gregorian year with at least four digits, another calendar's year as its full number",
    "timeStyles": "short is the CLDR short time; medium, long and full are the CLDR medium time, because a wall-clock time has no zone name",
    "datetime": "the date in the style, a space, and the time in the style, both in the timeZone",
    "timeZone": "local (default) is the host's current time zone, or the zone a request-scoped resolver supplies (ESM); utc is UTC; any other value is an IANA time zone ID; a zone the platform cannot resolve (unknown, or missing from its zone data) is an evaluation error naming the zone, never a silent UTC",
    "digits": "the digits of the formatting locale's default numbering system (Latin with -u-nu-latn), as for numbers",
    "pinnedNames": ".NET writes the pinned CLDR format-context weekday for an EEEE pattern and the pinned flexible day period for a B time pattern",
    "engineCoverage": "ESM formats a locale its engine has no data for with the nearest CLDR parent the engine has, else en-US",
    "spaces": "U+202F is written as U+0020; a run of one bidirectional mark (U+200E, U+200F, U+061C) is written once",
    "conformance": "corpus/rmf2-date-percent-conformance.json"
  },
  "selection": {
    "numericRank": [
      "exact",
      "category",
      "wildcard"
    ],
    "otherRank": [
      "exact",
      "wildcard"
    ],
    "order": "lexicographic in selector order",
    "tie": "first authored variant",
    "comparisonNormalization": "NFC",
    "duplicateVectors": "reject after NFC and selector-specific decimal canonicalization",
    "fallback": "required all-wildcard vector",
    "categoryOperands": "CLDR n, i, v, w, f, t of the visible decimal; e = 0",
    "exactNumericKeys": "canonical value of the visible decimal"
  },
  "selectionVectors": [
    { "id": "en-default-one", "locale": "en", "message": ".input {$n :number}\n.match $n\none {{{$n} file}}\n* {{{$n} files}}", "arguments": { "n": { "type": "decimal", "value": "1.0" } }, "expected": "1 file" },
    { "id": "en-minimum-fraction-digits-other", "locale": "en", "message": ".input {$n :number minimumFractionDigits=1}\n.match $n\none {{{$n} file}}\n* {{{$n} files}}", "arguments": { "n": { "type": "decimal", "value": "1" } }, "expected": "1.0 files" },
    { "id": "en-maximum-fraction-digits-one", "locale": "en", "message": ".input {$n :number maximumFractionDigits=0}\n.match $n\none {{{$n} file}}\n* {{{$n} files}}", "arguments": { "n": { "type": "decimal", "value": "1.4" } }, "expected": "1 file" },
    { "id": "en-half-expand-into-one", "locale": "en", "message": ".input {$n :number maximumFractionDigits=0}\n.match $n\none {{{$n} file}}\n* {{{$n} files}}", "arguments": { "n": { "type": "decimal", "value": "0.5" } }, "expected": "1 file" },
    { "id": "en-negative-one", "locale": "en", "message": ".input {$n :number}\n.match $n\none {{{$n} degree}}\n* {{{$n} degrees}}", "arguments": { "n": { "type": "decimal", "value": "-1" } }, "expected": "-1 degree" },
    { "id": "en-percent-one", "locale": "en", "message": ".input {$rate :number style=percent}\n.match $rate\none {{one: {$rate}}}\n* {{other: {$rate}}}", "arguments": { "rate": { "type": "decimal", "value": "0.01" } }, "expected": "one: 1%" },
    { "id": "en-percent-hundred-other", "locale": "en", "message": ".input {$rate :number style=percent}\n.match $rate\none {{one: {$rate}}}\n* {{other: {$rate}}}", "arguments": { "rate": { "type": "decimal", "value": "1" } }, "expected": "other: 100%" },
    { "id": "en-percent-minimum-fraction-digits-other", "locale": "en", "message": ".input {$rate :number style=percent minimumFractionDigits=1}\n.match $rate\none {{one: {$rate}}}\n* {{other: {$rate}}}", "arguments": { "rate": { "type": "decimal", "value": "0.01" } }, "expected": "other: 1.0%" },
    { "id": "en-percent-exact-key", "locale": "en", "message": ".input {$rate :number style=percent}\n.match $rate\n100 {{complete}}\n1 {{one percent}}\n* {{{$rate}}}", "arguments": { "rate": { "type": "decimal", "value": "1" } }, "expected": "complete" },
    { "id": "en-exact-key-after-rounding", "locale": "en", "message": ".input {$n :number maximumFractionDigits=0}\n.match $n\n1 {{exactly {$n}}}\none {{one {$n}}}\n* {{other {$n}}}", "arguments": { "n": { "type": "decimal", "value": "1.4" } }, "expected": "exactly 1" },
    { "id": "en-exact-key-ignores-padding", "locale": "en", "message": ".input {$n :number minimumFractionDigits=2}\n.match $n\n1 {{exactly {$n}}}\n* {{other {$n}}}", "arguments": { "n": { "type": "decimal", "value": "1" } }, "expected": "exactly 1.00" },
    { "id": "en-select-exact-after-rounding", "locale": "en", "message": ".input {$n :number select=exact maximumFractionDigits=0}\n.match $n\n2 {{two}}\n* {{other {$n}}}", "arguments": { "n": { "type": "decimal", "value": "1.5" } }, "expected": "two" },
    { "id": "en-ordinal-rounded", "locale": "en", "message": ".input {$n :number select=ordinal maximumFractionDigits=0}\n.match $n\none {{{$n}st}}\ntwo {{{$n}nd}}\nfew {{{$n}rd}}\n* {{{$n}th}}", "arguments": { "n": { "type": "decimal", "value": "21.6" } }, "expected": "22nd" },
