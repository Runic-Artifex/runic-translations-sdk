<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:2.0" version="2.1" srcLang="en" trgLang="de">
  <file id="shop" original="shop.de.xliff">
    <group id="cart" name="cart">
      <unit id="cart_items">
        <notes>
          <note category="description">The cart summary.</note>
          <note category="runic:unit"></note>
        </notes>
        <segment id="1" state="translated">
          <source><ph id="1" equiv="{$count :integer}" disp="count"/> items in your cart</source>
          <target><ph id="1" equiv="{$count :integer}" disp="count"/> Artikel im Warenkorb</target>
        </segment>
      </unit>
      <group id="cart_checkout" name="checkout">
        <unit id="cart_checkout_title">
          <notes>
            <note category="runic:unit"></note>
          </notes>
          <segment id="1" state="translated">
            <source>Checkout</source>
            <target>Kasse</target>
          </segment>
        </unit>
        <unit id="cart_checkout_total">
          <notes>
            <note category="runic:unit"></note>
          </notes>
          <segment id="1" state="translated">
            <source>Total: <ph id="1" equiv="{$amount :number minimumFractionDigits=2}" disp="amount"/></source>
            <target>Gesamt: <ph id="1" equiv="{$amount :number minimumFractionDigits=2}" disp="amount"/></target>
          </segment>
        </unit>
      </group>
    </group>
    <unit id="greeting">
      <notes>
        <note category="description">The greeting on the start page.
@param $name - the customer's first name</note>
        <note category="runic:unit"></note>
      </notes>
      <segment id="1" state="translated">
        <source>Hello <ph id="1" equiv="{$name}" disp="name"/>!</source>
        <target>Hallo <ph id="1" equiv="{$name}" disp="name"/>!</target>
      </segment>
    </unit>
  </file>
</xliff>
