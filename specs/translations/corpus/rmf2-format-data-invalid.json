    { "id": "compact-record-not-an-array", "patch": [{ "op": "replace", "path": "/formatData/locales/en/compact/latn/short/0", "value": "0K" }] },
    { "id": "compact-style-unknown", "patch": [{ "op": "add", "path": "/formatData/locales/en/compact/latn/medium", "value": [["0K"]] }] },
    { "id": "compact-too-many-zeros", "patch": [{ "op": "replace", "path": "/formatData/locales/en/compact/latn/short/0", "value": ["00K"] }] },
    { "id": "compact-two-zero-runs", "patch": [{ "op": "replace", "path": "/formatData/locales/en/compact/latn/short/3", "value": ["0M0"] }] },
    { "id": "compact-unbalanced-quote", "patch": [{ "op": "replace", "path": "/formatData/locales/en/compact/latn/short/0", "value": ["0'K"] }] },
    { "id": "numbers-unknown-member", "patch": [{ "op": "add", "path": "/formatData/numbers/symbols", "value": {} }] },
    { "id": "numbers-record-length", "patch": [{ "op": "add", "path": "/formatData/numbers/locales/en", "value": ["latn"] }] },
    { "id": "numbers-record-not-strings", "patch": [{ "op": "replace", "path": "/formatData/numbers/locales/en/5", "value": 3 }] },
    { "id": "numbers-latin-digits", "patch": [{ "op": "replace", "path": "/formatData/numbers/locales/en/1", "value": "0123" }] },
    { "id": "numbers-native-digits-mixed-width", "patch": [{ "op": "add", "path": "/formatData/numbers/locales/en", "value": ["arab", "٠١٢٣٤٥٦٧٨𞥐", "٫", "٬", "-", "3", "3", "3", "3", "", "%", "-", "%", "0123456789", ".", ",", "-", "3", "3", "3", "3", "", "%", "-", "%"] }] },
    { "id": "numbers-group-size-zero", "patch": [{ "op": "replace", "path": "/formatData/numbers/locales/en/6", "value": "0" }] },
    { "id": "numbers-symbol-empty", "patch": [{ "op": "replace", "path": "/formatData/numbers/locales/en/2", "value": "" }] },
    { "id": "numbers-affix-too-long", "patch": [{ "op": "replace", "path": "/formatData/numbers/locales/en/10", "value": "%%%%%%%%%%%%%%%%%" }] },
    { "id": "numbers-grouping-out-of-range", "patch": [{ "op": "add", "path": "/formatData/numbers/grouping/en", "value": 5 }] },
    { "id": "numbers-likely-invalid-tag", "patch": [{ "op": "add", "path": "/formatData/numbers/likely/en", "value": "en_Latn!" }] },
    { "id": "numbers-parents-invalid-key", "patch": [{ "op": "add", "path": "/formatData/numbers/parents/-en", "value": "root" }] },
