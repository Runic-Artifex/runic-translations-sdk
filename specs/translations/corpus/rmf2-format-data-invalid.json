{
  "corpusVersion": 2,
  "description": "Crafted formatData members of a locale artifact v5 that both runtimes reject as RTR0023/malformed, in exact packs and overlays (Rmf2FormatDataValidationTests). Each case is a pack recipe (README, \"Pack recipes\") applied to the base artifact, an English catalog that uses :currency (standard and accounting), :unit and compact notation. The rules are those of rmf2-execution-v2.md, Embedded format data.",
  "packBase": "compiled/format-data-invalid/en.json",
  "cases": [
    { "id": "unknown-member", "patch": [{ "op": "add", "path": "/formatData/symbols", "value": {} }] },
    { "id": "not-an-object", "patch": [{ "op": "replace", "path": "/formatData", "value": [] }] },
    { "id": "currencies-without-locales", "patch": [{ "op": "remove", "path": "/formatData/locales" }] },
    { "id": "locales-without-currencies", "patch": [{ "op": "remove", "path": "/formatData/currencies" }] },
    { "id": "currency-digits-out-of-range", "patch": [{ "op": "add", "path": "/formatData/currencies/EUR", "value": 7 }] },
    { "id": "currency-digits-not-integer", "patch": [{ "op": "add", "path": "/formatData/currencies/EUR", "value": 2.5 }] },
    { "id": "currency-code-lowercase", "patch": [{ "op": "add", "path": "/formatData/currencies/eur", "value": 2 }] },
    { "id": "dynamic-currency-not-embedded", "patch": [{ "op": "add", "path": "/formatData/dynamicCurrencies", "value": ["GBP"] }] },
    { "id": "dynamic-currency-duplicate", "patch": [{ "op": "add", "path": "/formatData/dynamicCurrencies", "value": ["EUR", "EUR"] }] },
    { "id": "dynamic-unit-invalid", "patch": [{ "op": "add", "path": "/formatData/dynamicUnits", "value": ["kilo--meter"] }] },
