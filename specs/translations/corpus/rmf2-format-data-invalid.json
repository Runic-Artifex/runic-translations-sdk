    { "id": "separator-too-long", "patch": [{ "op": "add", "path": "/formatData/locales/en/currencies/EUR", "value": ["€", "€", "euros", null, null, null, null, null, null, "decimal-mark"] }] },
    { "id": "unit-id-invalid", "patch": [{ "op": "add", "path": "/formatData/locales/en/units/Kilometer", "value": [["{0} km"]] }] },
    { "id": "unit-widths-empty", "patch": [{ "op": "add", "path": "/formatData/locales/en/units/kilometer-per-hour", "value": [] }] },
    { "id": "unit-long-width-null", "patch": [{ "op": "add", "path": "/formatData/locales/en/units/kilometer-per-hour", "value": [null, ["{0} km/h"]] }] },
    { "id": "unit-pattern-two-numbers", "patch": [{ "op": "add", "path": "/formatData/locales/en/units/kilometer-per-hour", "value": [["{0} {0} km/h"]] }] },
    { "id": "unit-pattern-second-placeholder", "patch": [{ "op": "add", "path": "/formatData/locales/en/units/kilometer-per-hour", "value": [["{0} {1}"]] }] },
    { "id": "per-unit-pattern-without-number", "patch": [{ "op": "add", "path": "/formatData/locales/en/units/kilometer-per-hour", "value": [["{0} km/h", null, null, null, null, null, "per km/h"]] }] },
    { "id": "per-pattern-placeholders", "patch": [{ "op": "add", "path": "/formatData/locales/en/per", "value": { "long": "{0} per" } }] },
    { "id": "per-width-unknown", "patch": [{ "op": "add", "path": "/formatData/locales/en/per", "value": { "wide": "{0}/{1}" } }] },
