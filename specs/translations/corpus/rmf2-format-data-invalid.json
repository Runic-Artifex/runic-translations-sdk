    { "id": "numbering-system-invalid", "patch": [{ "op": "add", "path": "/formatData/locales/en/currencyFormats/Latn", "value": ["¤#,##0.00", "¤#,##0.00;(¤#,##0.00)", "{0} {1}"] }] },
    { "id": "accounting-pattern-null", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/1", "value": null }] },
    { "id": "currency-pattern-without-digits", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/0", "value": "abc¤" }] },
    { "id": "currency-pattern-without-currency-sign", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/0", "value": "#,##0.00" }] },
