    { "id": "currency-formats-record-short", "patch": [{ "op": "add", "path": "/formatData/locales/en/currencyFormats/latn", "value": ["¤#,##0.00", "¤#,##0.00"] }] },
    { "id": "record-trailing-null", "patch": [{ "op": "add", "path": "/formatData/locales/en/currencies/EUR", "value": ["€", null, "euros", null] }] },
    { "id": "record-too-long", "patch": [{ "op": "add", "path": "/formatData/locales/en/currencies/EUR", "value": ["€", "€", "euros", null, null, null, null, null, null, ".", ",", "x"] }] },
    { "id": "currency-name-missing", "patch": [{ "op": "add", "path": "/formatData/locales/en/currencies/EUR", "value": ["€", "€", null, "euro"] }] },
