    { "id": "currency-pattern-empty-group", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/0", "value": "¤#,,##0.00" }] },
    { "id": "currency-pattern-two-decimal-points", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/0", "value": "¤#,##0.0.0" }] },
    { "id": "currency-pattern-split-digits", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/0", "value": "¤#,##0 .00" }] },
    { "id": "currency-pattern-unbalanced-quote", "patch": [{ "op": "replace", "path": "/formatData/locales/en/currencyFormats/latn/0", "value": "¤'#,##0.00" }] },
