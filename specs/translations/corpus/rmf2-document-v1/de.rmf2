guide {
  backup =
    .input {$fileName :string}
    {{{#p}{#strong}Bevor Sie fortfahren{/strong}, sichern Sie {$fileName}.{/p}
    {#ul}
      {#li}Lesen Sie die {#link ref=guide}Anleitung{/link}.{/li}
      {#li}{#action ref=check}Prüfen{/action} Sie das Ergebnis.{/li}
    {/ul}
    {#p}Sie können fortfahren, wenn die Prüfung abgeschlossen ist.{/p}}}
}
files =
  .input {$count :integer}
  .match $count
  0 {{}}
  one {{{#p}Eine Datei ist bereit.{/p}}}
  * {{{#p}{$count} Dateien sind bereit.{/p}{#ul}{#li}Prüfen Sie sie.{/li}{/ul}}}
