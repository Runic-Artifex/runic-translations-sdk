{
  "corpusVersion": 1,
  "transportVersion": 2,
  "catalog": "ops",
  "baseLocale": "en",
  "locales": [
    "en",
    "de"
  ],
  "fingerprints": {
    "$writer": "The writer catalog's contract fingerprint.",
    "$reader": "The reader catalog's contract fingerprint."
  },
  "writer": {
    "en": "steps {\n  build = Building {$name}\n  download =\n    .input {$count :integer}\n    .match $count\n    one {{Downloading one file}}\n    * {{Downloading {$count} files}}\n  cleanup = Cleaning up\n  check = Checking {$target}\n}\noperation {\n  failed = {$step} failed\n  summary = Changed {$names :runic:list}\n  retry = Retry {$attempt} of {$total :integer}\n  notice = Read the {#strong}notes{/strong}\n}\n",
    "de": "steps {\n  build = {$name} wird gebaut\n  download =\n    .input {$count :integer}\n    .match $count\n    one {{Eine Datei wird heruntergeladen}}\n    * {{{$count} Dateien werden heruntergeladen}}\n  cleanup = Aufräumen\n  check = {$target} wird geprüft\n}\noperation {\n  failed = {$step} ist fehlgeschlagen\n  summary = Geändert: {$names :runic:list}\n  retry = Versuch {$attempt} von {$total :integer}\n  notice = Lies die {#strong}Hinweise{/strong}\n}\n"
  },
  "reader": {
    "en": "steps {\n  build = Building package {$name}\n  download =\n    .input {$count :integer}\n    .match $count\n    one {{Downloading one file}}\n    * {{Downloading {$count} files}}\n  check = Checking {$path}\n  verify = Verifying {$name}\n}\noperation {\n  failed = {$step} failed\n  summary = Changed {$names :runic:list}\n  retry = Retry {$attempt :integer} of {$total :integer}\n  notice = Read the {#strong}notes{/strong}\n}\n",
    "de": "steps {\n  build = Bau von Paket {$name}\n  download =\n    .input {$count :integer}\n    .match $count\n    one {{Eine Datei wird heruntergeladen}}\n    * {{{$count} Dateien werden heruntergeladen}}\n  check = {$path} wird geprüft\n  verify = {$name} wird überprüft\n}\noperation {\n  failed = {$step} ist fehlgeschlagen\n  summary = Geändert: {$names :runic:list}\n  retry = Versuch {$attempt :integer} von {$total :integer}\n  notice = Lies die {#strong}Hinweise{/strong}\n}\n"
  },
