      { "preferences": ["sr-Latn-RS"], "expected": "de" },
      { "preferences": ["sr-Cyrl-RS", "en"], "expected": "sr" },
      { "preferences": ["pa-Guru-IN", "en"], "expected": "pa" }
    ] },
    { "id": "german-regions", "locales": ["de-AT", "de-DE", "en-US"], "base": "en-US", "cases": [
