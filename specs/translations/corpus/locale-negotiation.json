      { "preferences": ["sr-Cyrl-ME"], "expected": "sr" },
      { "preferences": ["sh"], "expected": "en" }
    ] },
    { "id": "script-mismatch-next-preference", "locales": ["az", "de", "en", "hi", "ku", "ms", "pa", "sr", "zh"], "base": "de", "cases": [
