{
  "corpusVersion": 1,
  "cldrVersion": "48.2",
  "comment": "Shared .NET (LocaleNegotiation.Negotiate) and ESM (negotiateLocale) oracle. Each group declares its locales and base locale; each case lists preferences, most preferred first.",
  "groups": [
    { "id": "chinese-scripts", "locales": ["en", "zh", "zh-Hant"], "base": "en", "cases": [
      { "preferences": ["zh-TW"], "expected": "zh-Hant" },
      { "preferences": ["zh-HK"], "expected": "zh-Hant" },
      { "preferences": ["zh-MO"], "expected": "zh-Hant" },
      { "preferences": ["zh_TW"], "expected": "zh-Hant" },
      { "preferences": ["zh-CN"], "expected": "zh" },
      { "preferences": ["zh-SG"], "expected": "zh" },
      { "preferences": ["zh-Hans"], "expected": "zh" },
      { "preferences": ["zh-Hant-TW"], "expected": "zh-Hant" },
      { "preferences": ["cmn"], "expected": "zh" }
    ] },
    { "id": "chinese-simplified-only", "locales": ["en", "zh"], "base": "en", "cases": [
      { "preferences": ["zh-TW"], "expected": "zh" },
      { "preferences": ["zh-Hant"], "expected": "zh" }
    ] },
    { "id": "chinese-traditional-only", "locales": ["en", "zh-Hant"], "base": "en", "cases": [
      { "preferences": ["zh-TW"], "expected": "zh-Hant" },
      { "preferences": ["zh"], "expected": "en" }
    ] },
    { "id": "serbian-scripts", "locales": ["en", "sr", "sr-Latn"], "base": "en", "cases": [
      { "preferences": ["sr-Latn-RS"], "expected": "sr-Latn" },
      { "preferences": ["sr-RS"], "expected": "sr" },
      { "preferences": ["sr-Cyrl-BA"], "expected": "sr" },
      { "preferences": ["sr-ME"], "expected": "sr-Latn" }
    ] },
    { "id": "serbian-cyrillic-only", "locales": ["en", "sr"], "base": "en", "cases": [
      { "preferences": ["sr-Latn-RS"], "expected": "sr" }
    ] },
    { "id": "german-regions", "locales": ["de-AT", "de-DE", "en-US"], "base": "en-US", "cases": [
      { "preferences": ["de-CH"], "expected": "de-DE" },
      { "preferences": ["de"], "expected": "de-DE" },
      { "preferences": ["de-AT"], "expected": "de-AT" },
      { "preferences": ["de-LI"], "expected": "de-DE" },
      { "preferences": ["de-Latn-CH"], "expected": "de-DE" },
      { "preferences": ["de_CH.UTF-8"], "expected": "de-DE" },
      { "preferences": ["en-GB"], "expected": "en-US" },
      { "preferences": ["fr"], "expected": "en-US" }
    ] },
    { "id": "german-language", "locales": ["de", "de-DE", "en"], "base": "en", "cases": [
      { "preferences": ["de-CH"], "expected": "de" },
      { "preferences": ["de-DE"], "expected": "de-DE" }
    ] },
    { "id": "english-regions", "locales": ["en-GB", "en-US"], "base": "en-US", "cases": [
      { "preferences": ["en"], "expected": "en-US" },
      { "preferences": ["en-AU"], "expected": "en-GB" },
      { "preferences": ["en-IN"], "expected": "en-GB" },
      { "preferences": ["en-CA"], "expected": "en-US" },
      { "preferences": ["en-PR"], "expected": "en-US" }
    ] },
    { "id": "spanish-regions", "locales": ["en", "es", "es-419"], "base": "en", "cases": [
      { "preferences": ["es-MX"], "expected": "es-419" },
      { "preferences": ["es-AR"], "expected": "es-419" },
      { "preferences": ["es-ES"], "expected": "es" },
      { "preferences": ["es"], "expected": "es" }
    ] },
    { "id": "spanish-siblings", "locales": ["en", "es-AR", "es-ES"], "base": "en", "cases": [
      { "preferences": ["es-MX"], "expected": "es-AR" },
      { "preferences": ["es"], "expected": "es-ES" },
      { "preferences": ["es-GQ"], "expected": "es-ES" }
    ] },
    { "id": "portuguese", "locales": ["en", "pt", "pt-PT"], "base": "en", "cases": [
      { "preferences": ["pt-AO"], "expected": "pt-PT" },
      { "preferences": ["pt-MZ"], "expected": "pt-PT" },
      { "preferences": ["pt-BR"], "expected": "pt" }
    ] },
    { "id": "norwegian-bokmal", "locales": ["en", "nb"], "base": "en", "cases": [
      { "preferences": ["no"], "expected": "nb" },
      { "preferences": ["nb-NO"], "expected": "nb" },
      { "preferences": ["no-NO"], "expected": "nb" },
      { "preferences": ["nn"], "expected": "en" }
    ] },
    { "id": "norwegian", "locales": ["en", "no"], "base": "en", "cases": [
      { "preferences": ["nb"], "expected": "no" },
      { "preferences": ["nn"], "expected": "no" },
      { "preferences": ["nb-NO"], "expected": "no" }
    ] },
    { "id": "norwegian-both", "locales": ["en", "nb", "nn"], "base": "en", "cases": [
      { "preferences": ["nn-NO"], "expected": "nn" },
      { "preferences": ["no"], "expected": "nb" }
    ] },
    { "id": "aliases", "locales": ["en", "he", "id"], "base": "en", "cases": [
      { "preferences": ["iw"], "expected": "he" },
      { "preferences": ["iw-IL"], "expected": "he" },
      { "preferences": ["in"], "expected": "id" }
    ] },
    { "id": "preference-lists", "locales": ["de", "en", "fr"], "base": "en", "cases": [
      { "preferences": ["xx", "fr-CA", "de"], "expected": "fr" },
      { "preferences": ["it", "de-AT", "fr"], "expected": "de" },
      { "preferences": [], "expected": "en" },
      { "preferences": ["de_DE.UTF-8"], "expected": "de" },
      { "preferences": ["de_DE@euro"], "expected": "de" },
      { "preferences": ["C", "POSIX", "", "fr"], "expected": "fr" },
      { "preferences": ["-", "de-"], "expected": "en" },
      { "preferences": ["DE-de"], "expected": "de" },
      { "preferences": ["de-u-co-phonebk"], "expected": "de" },
      { "preferences": ["de-x-private"], "expected": "de" }
    ] }
  ]
}
