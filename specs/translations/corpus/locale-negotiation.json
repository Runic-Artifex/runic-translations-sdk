      { "preferences": ["cnr"], "expected": "sr-Latn" },
      { "preferences": ["jw"], "expected": "jv" },
      { "preferences": ["drw"], "expected": "fa" }
    ] },
    { "id": "legacy-declared", "locales": ["en", "tl"], "base": "en", "cases": [
