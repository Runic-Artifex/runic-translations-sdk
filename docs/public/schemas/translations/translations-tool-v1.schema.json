{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/translations-tool-v1.schema.json",
  "title": "runic.translations.tool/1",
  "description": "The payload of every runic-translations command except support, inside the runic.commandline/1 envelope of --format json: as payload on success, as fault.data.payload on failure. output and error are display text, not a parseable format. Later releases may add properties; readers ignore properties they do not know.",
  "type": "object",
  "required": [
    "output",
    "error",
    "diagnostics"
  ],
  "properties": {
    "output": {
      "type": "string",
      "description": "The human output text."
    },
    "error": {
      "type": "string",
      "description": "The human error text."
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      },
      "description": "Translation diagnostics under their RTR codes, with source locations."
    },
    "interchange": {
      "$ref": "#/$defs/interchange",
      "description": "The outcome of xliff export, xliff import, import and review mark; absent for the other commands."
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "message",
        "path",
        "line",
        "column",
        "endLine",
        "endColumn",
        "helpUri"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^RTR[0-9]{4}$",
          "description": "The RTR code."
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "description": "The message, without location or code."
        },
        "path": {
          "type": "string",
          "description": "The source path with forward slashes, relative to the working directory where possible."
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        },
        "helpUri": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "interchange": {
      "type": "object",
      "required": [
        "operation",
        "catalog",
        "dryRun",
        "documents",
        "units",
        "entries",
        "entriesTruncated",
        "notices",
        "files"
      ],
      "properties": {
        "operation": {
          "enum": [
            "export",
            "import",
            "review-mark"
          ],
          "description": "export (xliff export), import (xliff import and import --from), or review-mark."
        },
        "catalog": {
          "type": "string",
          "description": "The catalog identifier."
        },
        "format": {
          "enum": [
            "xliff",
            "resx",
            "i18next"
          ],
          "description": "The source format of an import: xliff for xliff import, resx or i18next for import --from."
        },
        "locale": {
          "type": "string",
          "description": "The target locale of an xliff import or a review mark, or the only locale an import --from read."
        },
        "dryRun": {
          "type": "boolean",
          "description": "Whether the import wrote nothing (--dry-run)."
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interchangeDocument"
          },
          "description": "The XLIFF documents that export wrote, or the source files that import --from read (units: the entries each file holds, including skipped ones)."
        },
        "units": {
          "$ref": "#/$defs/interchangeCounts"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interchangeEntry"
          },
          "description": "One entry per unit that was added, changed, skipped, refused, marked or demoted, or whose source changed (unchanged), at most 1000."
        },
        "entriesTruncated": {
          "type": "boolean",
          "description": "Whether more entries exist than entries lists."
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interchangeNotice"
          },
          "description": "Notices that changed nothing, such as an ignored translator note (XLIFF21-NOTE-IGNORED) or a demoted approval (REVIEW-STALE)."
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interchangeFile"
          },
          "description": "The source files that were, or with --dry-run would be, written."
        },
        "reviewFile": {
          "type": "string",
          "description": "The review file that was read or written."
        }
      }
    },
    "interchangeDocument": {
      "type": "object",
      "required": [
        "locale",
        "path",
        "units"
      ],
      "properties": {
        "locale": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "interchangeCounts": {
      "type": "object",
      "description": "Per-unit counts. An applied unit is also added, changed or unchanged.",
      "required": [
        "total",
        "applied",
        "added",
        "changed",
        "unchanged",
        "skipped",
        "refused",
        "sourceChanged",
        "demoted"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "applied": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "refused": {
          "type": "integer",
          "minimum": 0
        },
        "sourceChanged": {
          "type": "integer",
          "minimum": 0
        },
        "demoted": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "interchangeEntry": {
      "type": "object",
      "required": [
        "key",
        "outcome"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "The message key; for a message import --from could not map, the key as the source names it."
        },
        "locale": {
          "type": "string",
          "description": "The locale of the message, set by import --from, which reads several locales."
        },
        "outcome": {
          "enum": [
            "added",
            "changed",
            "unchanged",
            "skipped",
            "refused",
            "marked",
            "demoted"
          ]
        },
        "code": {
          "type": "string",
          "description": "The reason, such as XLIFF21-UNTRANSLATED or XLIFF21-SOURCE-CHANGED; for import --from, codes such as IMPORT-INVALID, IMPORT-NO-BASE, IMPORT-KEY-COLLISION, RESX-NON-STRING or I18NEXT-NESTING."
        },
        "message": {
          "type": "string"
        },
        "state": {
          "enum": [
            "draft",
            "translated",
            "needs-review",
            "approved"
          ],
          "description": "The review state of an applied, marked or demoted unit afterwards."
        }
      }
    },
    "interchangeNotice": {
      "type": "object",
      "required": [
        "code",
        "location",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "interchangeFile": {
      "type": "object",
      "required": [
        "path",
        "change"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "change": {
          "enum": [
            "added",
            "changed"
          ]
        }
      }
    }
  }
}
