{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/project-v1.schema.json",
  "title": "Runic Translations project v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalog",
    "code",
    "baseLocale"
  ],
  "properties": {
    "$schema": {
      "const": "https://runic-artifex.eu/schemas/translations/project-v1.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceRoots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "namespace"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "catalog": {
      "$ref": "#/$defs/id"
    },
    "code": {
      "$ref": "#/$defs/code"
    },
    "baseLocale": {
      "$ref": "#/$defs/localeTag"
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/localeTag"
          },
          {
            "$ref": "#/$defs/locale"
          }
        ]
      }
    },
    "pseudoLocales": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "en-XA",
          "ar-XB"
        ]
      },
      "description": "Development pseudo-locales generated from the base locale in Debug builds (MSBuild), in Vite modes other than production, and with --pseudo-locales: en-XA has accented, about 35% longer, bracketed text; ar-XB is right-to-left with mirrored text. Release builds leave them out. Do not also list them in locales."
    },
    "validation": {
      "$ref": "#/$defs/validation"
    },
    "overrides": {
      "type": "array",
      "description": "Library catalogs this application overrides. The overrides of a catalog are translations/overrides/<catalog>/<locale>.rmf2 beside runic.json, keyed by the library's full logical keys; they may replace messages of the library's locales and add locales. The build validates them against the catalog the package packs (RunicTranslationsPackCatalog, package.json runicTranslations) and compiles them into the application.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog", "from"],
        "properties": {
          "catalog": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]*$",
            "description": "The library's catalog ID, such as acme.grid."
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "The NuGet package ID or npm package name that ships the catalog, such as Acme.Grid or @acme/grid."
          }
        }
      }
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "markup": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "kind": {
                "enum": [
                  "paired",
                  "standalone"
                ]
              },
              "placement": {
                "enum": [
                  "inline"
                ]
              },
              "children": {
                "enum": [
                  "inline",
                  "none"
                ]
              },
              "interactive": {
                "type": "boolean"
              },
              "plainText": {
                "enum": [
                  "children",
                  "lineBreak",
                  "alternateText",
                  "explicit",
                  "omit"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "string",
                        "number",
                        "integer",
                        "boolean",
                        "enum"
                      ]
                    },
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1
                    },
                    "minimum": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "maximum": {
                      "type": "integer",
                      "minimum": -2147483648,
                      "maximum": 2147483647
                    },
                    "default": {
                      "type": "string"
                    },
                    "literalOnly": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "kind",
              "children",
              "interactive",
              "plainText"
            ],
            "additionalProperties": false
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4096
                }
              },
              "required": [
                "min",
                "max"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "localeTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "locale": {
      "type": "object",
      "required": [
        "tag"
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/localeTag"
        },
        "fallback": {
          "$ref": "#/$defs/localeTag"
        },
        "validation": {
          "$ref": "#/$defs/validation",
          "description": "Validation policies for this locale only; each member overrides the project's validation for the locale's own translations."
        }
      },
      "additionalProperties": false
    },
    "code": {
      "type": "object",
      "required": [
        "namespace",
        "className"
      ],
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "className": {
          "$ref": "#/$defs/identifier"
        },
        "visibility": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "referenceFallbackText": {
          "type": "boolean",
          "default": true,
          "description": "Generated C# reference factories (Class.References) include the base-locale text as the reference's fallback text."
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "enum": [
        "allow",
        "warning",
        "error"
      ]
    },
    "validation": {
      "type": "object",
      "properties": {
        "translationCompleteness": {
          "$ref": "#/$defs/policy",
          "default": "error",
          "description": "A base-locale message the locale does not translate (RTR0010)."
        },
        "extraLocaleKeys": {
          "$ref": "#/$defs/policy",
          "default": "error",
          "description": "A locale defines a message the base locale does not (RTR0011)."
        },
        "emptyValues": {
          "$ref": "#/$defs/policy",
          "default": "allow",
          "description": "A message has an empty variant (RTR0021)."
        },
        "pluralCategories": {
          "$ref": "#/$defs/policy",
          "default": "warning",
          "description": "A plural or ordinal key the locale never selects (RTR0094), or categories the locale needs that fall to the * variant (RTR0095)."
        },
        "inputParity": {
          "$ref": "#/$defs/policy",
          "default": "warning",
          "description": "A translation displays no input the base displays, in any variant (RTR0096)."
        },
        "formattedBooleans": {
          "$ref": "#/$defs/policy",
          "default": "warning",
          "description": "A boolean formatted as text, which reads true or false in every locale (RTR0097)."
        },
        "maxLength": {
          "$ref": "#/$defs/policy",
          "default": "warning",
          "description": "A message's text is longer than its @maxLength (RTR0098)."
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "unsupportedLocale": {
          "enum": [
            "exact",
            "parentsThenDefault",
            "default"
          ]
        },
        "missingKey": {
          "enum": [
            "throw",
            "returnKey",
            "returnMarker"
          ]
        },
        "bidiIsolation": {
          "description": "Isolates placeholders with Unicode MessageFormat 2's default bidi strategy (FSI, LRI or RLI before a placeholder, PDI after it). default: decided per format call, on when the requested, catalog or content locale is right to left (so right-to-left overlays of left-to-right catalogs are isolated too); on: always; off: never. A u:dir option of ltr, rtl or auto isolates its placeholder in every mode.",
          "enum": [
            "default",
            "on",
            "off"
          ],
          "default": "default"
        }
      },
      "additionalProperties": false
    }
  }
}
