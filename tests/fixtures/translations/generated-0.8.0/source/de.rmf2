grid_empty = Keine Zeilen
grid_rows =
  .input {$count :integer}
  .match $count
  one {{{$count} Zeile}}
  * {{{$count} Zeilen}}
grid_hint = Drücken Sie {#strong}Eingabe{/strong} zum Bearbeiten
grid_total =
  .input {$amount :number}
  {{Summe {$amount}}}
grid_updated =
  .input {$when :date style=long}
  {{Aktualisiert am {$when}}}
