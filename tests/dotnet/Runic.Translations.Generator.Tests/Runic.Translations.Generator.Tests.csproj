<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <ProjectReference Include="..\..\..\packages\dotnet\Runic.Translations.Generator\Runic.Translations.Generator.csproj" />
    <ProjectReference Include="..\..\..\packages\dotnet\Runic.Translations\Runic.Translations.csproj" />
  </ItemGroup>

  <!-- The published 0.8.0 runtime, for PreviousReleasePackTests: downloaded, not referenced; the test loads it beside the current one. -->
  <ItemGroup>
    <PackageDownload Include="Runic.Translations" Version="[0.8.0]" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RunicTranslations080</_Parameter1>
      <_Parameter2>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))runic.translations/0.8.0/lib/net10.0/Runic.Translations.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Import Project="../../../eng/build/translations.targets" />
</Project>
