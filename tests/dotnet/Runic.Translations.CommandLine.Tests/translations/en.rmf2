# Application text, keyed by DescriptionKey, plus overrides of framework text.
commands {
  greet = Greet a person
  storeShow = Show the store
  # LongDescriptionKey text keeps its paragraphs and preformatted lines.
  storeShowDetails =
    Restart the service afterwards.

      /a   first entry
      /b   second entry
}
groups {
  store = Manage the store
  storeDetails = The store keeps one entry per container.
}
arguments {
  name = Name of the person to greet
}
options {
  times = How often to greet
}
help {
  usage = Synopsis
}
diagnostics {
  # Binds the framework argument by position.
  unknownOption =
    .input {$arg0 :string}
    {{No such option: {$arg0}}}
  # Declares an input the framework never supplies, so the built-in text is used.
  missingArgument =
    .input {$person :string}
    {{Missing {$person}}}
  # An application diagnostic with positional arguments.
  quotaExceeded =
    .input {$arg0 :string}
    .input {$arg1 :integer}
    {{{$arg0} exceeded its quota of {$arg1}.}}
}
