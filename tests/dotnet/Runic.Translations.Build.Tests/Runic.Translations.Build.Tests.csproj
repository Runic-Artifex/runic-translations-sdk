<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <!-- A TUnit test application on Microsoft.Testing.Platform: run it with dotnet run or the built executable. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.Translations.Build.Tests</AssemblyName>
    <RootNamespace>Runic.Translations.Build.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TUnitImplicitUsings>false</TUnitImplicitUsings>
    <RestoreLockedMode Condition="'$(CI)' == 'true' and '$(RunicCommandLinePackageFeed)' == ''">true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit.Core" />
    <PackageReference Include="TUnit.Engine" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="JsonSchema.Net" PrivateAssets="all" />
    <PackageReference Include="NuGet.Versioning" PrivateAssets="all" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations/Runic.Translations.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations.Build/Runic.Translations.Build.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\..\tools\dotnet-runic-translations\dotnet-runic-translations.csproj" />
    <Compile Include="../Shared/PackedLibraryFixture.cs" Link="Shared/PackedLibraryFixture.cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/translations.targets" />
</Project>
