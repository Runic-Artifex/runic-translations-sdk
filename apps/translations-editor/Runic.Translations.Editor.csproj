<Project Sdk="Microsoft.NET.Sdk">
  <!-- RunicEditorUsePackedTranslations=true builds against locally packed Translations
       packages instead of source projects. Only bun eng/run.mjs verify-editor-packed sets it,
       because it also supplies the packaged tool as TranslationsToolCommand. -->
  <Import Project="../../packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.props"
          Condition="'$(RunicEditorUsePackedTranslations)' != 'true'" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RunicBridgeRegisterGlobally>false</RunicBridgeRegisterGlobally>
    <RunicBridgeCompositionType>Runic.Translations.Editor.RunicBridgeComposition</RunicBridgeCompositionType>
    <RunicBridgeFrontendBuildCommand>bun run --bun build</RunicBridgeFrontendBuildCommand>
    <RunicBridgeTypescriptDir>$(MSBuildProjectDirectory)/Frontend/src/generated</RunicBridgeTypescriptDir>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Runic.Translations.Editor</AssemblyName>
    <RootNamespace>Runic.Translations.Editor</RootNamespace>
    <Product>Runic Translations Editor</Product>
    <Title>Runic Translations Editor</Title>
    <Description>A focused desktop editor for Runic Translations workspaces.</Description>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <TranslationsEmitEsm>true</TranslationsEmitEsm>
    <TranslationsToolCommand>dotnet tool run runic-translations --</TranslationsToolCommand>
    <TranslationsToolCommand Condition="'$(RunicEditorUsePackedTranslations)' != 'true'">dotnet run --project &quot;$(RunicTranslationsRoot)tools/dotnet-runic-translations/dotnet-runic-translations.csproj&quot; --configuration Release --</TranslationsToolCommand>
    <TranslationsRuntimePath Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)/</TranslationsRuntimePath>
    <TranslationsOutputPath Condition="'$(RunicBridgeBootstrap)' != 'true'">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(TranslationsRuntimePath)translations</TranslationsOutputPath>
    <TranslationsOutputPath Condition="'$(RunicBridgeBootstrap)' == 'true'">obj/runic-bridge/bootstrap/obj/$(Configuration)/$(TargetFramework)/translations</TranslationsOutputPath>
    <RunicEditorUpdateChannel Condition="'$(RunicEditorUpdateChannel)' == ''">preview</RunicEditorUpdateChannel>
    <!-- The editor hosts its own generated Runic.CommandLine catalog beside the one
         published inside Runic.Translations.Tooling; the identical well-known
         generated type name is expected and the locally generated catalog wins. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">Windows</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('osx-'))">MacOS</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">Linux</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</RunicNativeProvider>
    <RunicNativeProvider Condition="'$(RunicNativeProvider)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacOS</RunicNativeProvider>
    <DefineConstants>$(DefineConstants);RUNIC_PLATFORM_$(RunicNativeProvider)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../eng/translations/Rmf2Preview.cs" Link="Shared/Rmf2Preview.cs" />
    <PackageReference Include="Runic.Platform.$(RunicNativeProvider)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RunicUpdateChannel" Value="$(RunicEditorUpdateChannel)" />
    <AssemblyMetadata Include="RepositoryCommit" Value="$(SourceRevisionId)" Condition="'$(SourceRevisionId)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Runic.Application.CsWebUi" GeneratePathProperty="true" />
    <PackageReference Include="Runic.Application.ReactiveUI" />
    <PackageReference Include="Runic.CommandLine" />
  </ItemGroup>

  <ItemGroup Condition="'$(RunicEditorUsePackedTranslations)' != 'true'">
    <ProjectReference Include="../../packages/dotnet/Runic.Translations/Runic.Translations.csproj" />
    <ProjectReference Include="../../tools/Runic.Translations.Compiler/Runic.Translations.Compiler.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations.Authoring/Runic.Translations.Authoring.csproj" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations.Tooling/Runic.Translations.Tooling.csproj" />
    <!-- Source-tree builds import the build props before their packaged analyzers
         exist. Register the compiler first so Roslyn resolves the generator's
         dependency from this same source-tree closure. -->
    <Analyzer Include="../../packages/dotnet/Runic.Translations.Generator/bin/$(Configuration)/net10.0/Runic.Translations.Compiler.dll" />
    <ProjectReference Include="../../packages/dotnet/Runic.Translations.Generator/Runic.Translations.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RunicEditorUsePackedTranslations)' == 'true'">
    <RunicEditorTranslationsPackageVersion Condition="'$(RunicEditorTranslationsPackageVersion)' == ''">$(RunicTranslationsVersion)</RunicEditorTranslationsPackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(RunicEditorUsePackedTranslations)' == 'true'">
    <!-- Runic.Translations.Tooling bundles the Authoring and Compiler assemblies;
         Runic.Translations.Build brings the build props, targets and analyzers. -->
    <PackageReference Include="Runic.Translations" VersionOverride="$(RunicEditorTranslationsPackageVersion)" />
    <PackageReference Include="Runic.Translations.Tooling" VersionOverride="$(RunicEditorTranslationsPackageVersion)" />
    <PackageReference Include="Runic.Translations.Build" VersionOverride="$(RunicEditorTranslationsPackageVersion)" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup Condition="'$(RunicBridgeBootstrap)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <TranslationProject Include="EditorResources/runic.json" />
    <TranslationMf2 Include="EditorResources/*.rmf2" />
    <None Update="ExampleWorkspace/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="PREVIEW-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="launchers/runic-translations-editor" Link="runic-translations-editor" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="launchers/runic-translations-editor.cmd" Link="runic-translations-editor.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Generated ESM artifacts persist across builds, but the generator target only
       registers them in @(FileWrites) when it actually runs. On an up-to-date rebuild
       IncrementalClean would otherwise classify them as orphaned obj/ writes and delete
       them, breaking the frontend build that consumes the manifest. -->
  <Target Name="KeepGeneratedTranslationsOutOfIncrementalClean"
          BeforeTargets="_CleanGetCurrentAndPriorFileWrites"
          Condition="'$(TranslationsOutputPath)' != '' and Exists('$(TranslationsOutputPath)/editor.esm-v5/web-module-manifest-v3.json')">
    <ItemGroup>
      <_ExistingTranslationsArtifacts Include="$(TranslationsOutputPath)/editor.esm-v5/**/*" />
      <FileWrites Include="@(_ExistingTranslationsArtifacts)" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareTranslationsEditorViewsFrontend"
          BeforeTargets="RunicViewsGenerateBridge"
          DependsOnTargets="RunicTranslationsGenerateTranslationArtifacts">
    <Copy SourceFiles="$(PkgRunic_Application_CsWebUi)/www/runic-cswebui.js"
          DestinationFiles="Frontend/static/runic-cswebui.js"
          SkipUnchangedFiles="true" />
    <WriteLinesToFile File="Frontend/.runic-translations-manifest-path"
                      Lines="$(MSBuildProjectDirectory)/$(TranslationsOutputPath)/editor.esm-v5/web-module-manifest-v3.json"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <!-- The frontend build also consumes generated translations and built
         workspace packages, which live outside Frontend. -->
    <ItemGroup>
      <RunicBridgeFrontendInput Include="$(TranslationsOutputPath)/editor.esm-v5/**/*" />
      <RunicBridgeFrontendInput Include="../../packages/web/translations-svelte/dist/**/*;../../packages/web/translations-sveltekit/dist/**/*" />
      <RunicBridgeFrontendInput Include="../../packages/web/vite-plugin-runic-translations/package.json;../../packages/web/vite-plugin-runic-translations/dist/**/*" />
    </ItemGroup>
  </Target>

  <Target Name="CopyTranslationsEditorFrontend" AfterTargets="Build"
          Condition="'$(RunicBridgeBootstrap)' != 'true'">
    <ItemGroup>
      <EditorBuiltFile Include="Frontend/build/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(EditorBuiltFile)"
          DestinationFiles="@(EditorBuiltFile->'$(TargetDir)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyTranslationsEditorFrontendForPublish" AfterTargets="Publish"
          Condition="'$(RunicBridgeBootstrap)' != 'true'">
    <ItemGroup><EditorPublishedFile Include="Frontend/build/**/*" /></ItemGroup>
    <Copy SourceFiles="@(EditorPublishedFile)"
          DestinationFiles="@(EditorPublishedFile->'$(PublishDir)www/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Import Project="../../packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.targets"
          Condition="'$(RunicEditorUsePackedTranslations)' != 'true'" />
  <ItemGroup>
    <PackageReference Include="Runic.CommandLine.Spectre" />
  </ItemGroup>
</Project>
