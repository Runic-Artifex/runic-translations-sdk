{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runic-artifex.eu/schemas/translations/editor-state-v2.schema.json",
  "title": "Runic Translations optional editor state v2 (notes, preview samples and terminology; review states live in <catalog>.review.json)",
  "type": "object",
  "required": ["$schema", "catalog", "messages", "terminology"],
  "properties": {
    "$schema": { "const": "runic.translations.editor-state/2" },
    "catalog": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/review" }
      }
    },
    "terminology": {
      "type": "array",
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/term" }
    }
  },
  "additionalProperties": false,
  "unevaluatedProperties": false,
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "review": {
      "type": "object",
      "properties": {
        "note": { "type": "string", "maxLength": 16384 },
        "samples": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": { "type": "string", "maxLength": 16384 }
        }
      },
      "additionalProperties": false
    },
    "term": {
      "type": "object",
      "required": ["source", "preferred"],
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "preferred": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "locale": { "type": "string", "minLength": 1, "maxLength": 128 },
        "note": { "type": "string", "maxLength": 16384 }
      },
      "additionalProperties": false
    }
  }
}
