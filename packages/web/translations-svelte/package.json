{
  "name": "@runic-artifex/translations-svelte",
  "version": "0.6.0-preview.5",
  "description": "Svelte 5 localization and RMF2 inline and document content helpers for Runic Translations",
  "homepage": "https://github.com/Runic-Artifex/runic-translations-sdk/tree/main/packages/web/translations-svelte#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-translations-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "translations",
    "svelte",
    "svelte-5",
    "rmf2"
  ],
  "license": "MIT",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "svelte": "./dist/translations/index.js",
      "import": "./dist/translations/index.js"
    },
    "./translations/testing": {
      "types": "./dist/translations/testing.d.ts",
      "import": "./dist/translations/testing.js"
    },
    "./inline": {
      "types": "./dist/inline/index.d.ts",
      "svelte": "./dist/inline/index.js",
      "import": "./dist/inline/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "svelte": "./dist/document/index.js",
      "import": "./dist/document/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && svelte-package -i src -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun run --bun build && vitest run test/locale.svelte.test.ts test/locale-hydration.svelte.test.ts test/localization-stress.test.ts test/document.svelte.test.ts && node test/verify-inline-ssr.mjs",
    "pack:check": "bun pm pack --dry-run",
    "test:inline-browser": "node test/verify-inline-ssr.mjs && node test/verify-inline-hydration.mjs && node test/verify-document-hydration.mjs",
    "test:document-example": "node test/verify-document-example.mjs"
  },
  "peerDependencies": {
    "svelte": ">=5.46.4 <6"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-translations-sdk.git",
    "directory": "packages/web/translations-svelte"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "happy-dom": "^20.14.5",
    "playwright-core": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2"
  }
}
