{
  "name": "@runic-artifex/translations-sveltekit",
  "version": "0.6.0-preview.2",
  "description": "SvelteKit locale routing and request integration for Runic Translations",
  "homepage": "https://github.com/Runic-Artifex/runic-translations-sdk/tree/main/packages/web/translations-sveltekit#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-translations-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "translations",
    "sveltekit",
    "localization",
    "i18n"
  ],
  "license": "MIT",
  "type": "module",
  "types": "./dist/translations/index.d.ts",
  "exports": {
    "./translations": {
      "types": "./dist/translations/index.d.ts",
      "import": "./dist/translations/index.js"
    },
    "./translations/navigation": {
      "types": "./dist/translations/navigation.d.ts",
      "svelte": "./dist/translations/navigation.js",
      "import": "./dist/translations/navigation.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && vitest run test/locale-routing.test.ts test/reference-app.test.ts",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=3 <4"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-translations-sdk.git",
    "directory": "packages/web/translations-sveltekit"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "devDependencies": {
    "@runic-artifex/translations-svelte": "workspace:*",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "happy-dom": "^20.14.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vite": "8.3.2"
  }
}
