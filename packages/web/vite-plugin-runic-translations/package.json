{
  "name": "@runic-artifex/vite-plugin-runic-translations",
  "version": "0.6.0-preview.3",
  "description": "Vite integration for compiling Runic Translations catalogs into application resources",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "bun -e \"import('node:fs').then(({rmSync}) => rmSync('dist', { recursive: true, force: true }))\"",
    "build": "bun run --bun clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun run --bun build && bun test --timeout 120000 test/*.test.js",
    "bench": "node bench/save-latency.mjs"
  },
  "peerDependencies": {
    "vite": ">=6 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Runic-Artifex/runic-translations-sdk.git",
    "directory": "packages/web/vite-plugin-runic-translations"
  },
  "homepage": "https://github.com/Runic-Artifex/runic-translations-sdk/tree/main/packages/web/vite-plugin-runic-translations#readme",
  "bugs": {
    "url": "https://github.com/Runic-Artifex/runic-translations-sdk/issues"
  },
  "keywords": [
    "runic-artifex",
    "localization",
    "i18n",
    "translations",
    "vite",
    "sveltekit",
    "esm",
    "tree-shaking",
    "hmr"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "tag": "preview"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
