<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Packed under lib/; its public API is tracked in PublicAPI.*.txt. -->
    <RunicTrackPublicApi>true</RunicTrackPublicApi>
    <Description>WPF inline and document rendering for compiled RMF2 messages.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Checks the copy projection of selections that UI tests cannot drive through the clipboard. -->
    <InternalsVisibleTo Include="Runic.Translations.Wpf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Runic.Translations/Runic.Translations.csproj" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../specs/translations/THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../../specs/translations/cldr/LICENSE" Pack="true" PackagePath="licenses" />
  </ItemGroup>
  <!-- Bounds the Runic.Translations dependency to this release's minor, [N, next minor-0.0), as for the adapter and every
       packed library (D061.16): a mismatched Translations runtime is then NU1608 at restore instead of a runtime break. -->
  <Import Project="../Runic.Translations.Build/build/Runic.Translations.Build.Pack.targets" />
  <Import Project="../../../eng/build/translations.targets" />
</Project>
