<Project>
  <PropertyGroup>
    <_Rmf2DiscoveryAssembly>$(MSBuildThisFileDirectory)../tools/net10.0/Runic.Translations.Build.dll</_Rmf2DiscoveryAssembly>
    <_Rmf2DiscoveryAssembly Condition="!Exists('$(_Rmf2DiscoveryAssembly)')">$(MSBuildThisFileDirectory)../bin/$(Configuration)/net10.0/Runic.Translations.Build.dll</_Rmf2DiscoveryAssembly>
  </PropertyGroup>
  <UsingTask TaskName="Runic.Translations.Build.Rmf2SourceDiscovery" AssemblyFile="$(_Rmf2DiscoveryAssembly)" Condition="Exists('$(_Rmf2DiscoveryAssembly)')" />
  <PropertyGroup>
    <_TranslationsBuildTargetsPath>$(MSBuildThisFileFullPath)</_TranslationsBuildTargetsPath>

    <_TranslationsEmitAny>false</_TranslationsEmitAny>
    <_TranslationsEmitAny Condition="'$(RunicTranslationsEmitJson)' == 'true' or '$(RunicTranslationsEmitEsm)' == 'true'">true</_TranslationsEmitAny>
    <_TranslationsGenerationEnabled>false</_TranslationsGenerationEnabled>
    <_TranslationsGenerationEnabled Condition="'$(RunicTranslationsGenerateOnBuild)' == 'true' or '$(_TranslationsEmitAny)' == 'true'">true</_TranslationsGenerationEnabled>
    <_RunicTranslationsBuildTargetsImported>true</_RunicTranslationsBuildTargetsImported>
  </PropertyGroup>

  <!-- Permanent guard (RTR0086): the names before the Runic prefix, and the retired emit selections,
       fail with an error naming the replacement instead of being ignored. -->
  <Target Name="_RunicTranslationsRejectRetiredNames"
          BeforeTargets="_RunicTranslationsDiscoverTranslationSources;RunicTranslationsGetXamlCatalogSources;RunicTranslationsCleanTranslationArtifacts">
    <Error Condition="'$(TranslationsGenerateOnBuild)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsGenerateOnBuild' was renamed to 'RunicTranslationsGenerateOnBuild'." />
    <Error Condition="'$(TranslationsEmitJson)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsEmitJson' was renamed to 'RunicTranslationsEmitJson'." />
    <Error Condition="'$(TranslationsEmitEsm)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsEmitEsm' was renamed to 'RunicTranslationsEmitEsm'." />
    <Error Condition="'$(TranslationsOutputPath)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsOutputPath' was renamed to 'RunicTranslationsOutputPath'." />
    <Error Condition="'$(TranslationsOutputStamp)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsOutputStamp' was renamed to 'RunicTranslationsOutputStamp'." />
    <Error Condition="'$(TranslationsWebOutputPath)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsWebOutputPath' was renamed to 'RunicTranslationsWebOutputPath'." />
    <Error Condition="'$(TranslationsToolCommand)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsToolCommand' was renamed to 'RunicTranslationsToolCommand'." />
    <Error Condition="'$(TranslationsToolAdditionalArguments)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsToolAdditionalArguments' was renamed to 'RunicTranslationsToolAdditionalArguments'." />
    <Error Condition="'$(TranslationsXamlCatalog)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsXamlCatalog' was renamed to 'RunicTranslationsXamlCatalog'." />
    <Error Condition="'$(TranslationsXamlReferencedCatalogs)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsXamlReferencedCatalogs' was renamed to 'RunicTranslationsXamlReferencedCatalogs'." />
    <Error Condition="'$(TranslationsValidateXaml)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsValidateXaml' was renamed to 'RunicTranslationsValidateXaml'." />
    <Error Condition="'@(TranslationProject)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild item 'TranslationProject' was renamed to 'RunicTranslationProject'." />
    <Error Condition="'@(TranslationMf2)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild item 'TranslationMf2' was renamed to 'RunicTranslationMf2'." />
    <Error Condition="'@(TranslationXaml)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild item 'TranslationXaml' was renamed to 'RunicTranslationXaml'." />
    <Error Condition="'@(TranslationsToolInput)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild item 'TranslationsToolInput' was renamed to 'RunicTranslationsToolInput'." />
    <Error Condition="'@(Page->HasMetadata('TranslationsValidateXaml'))' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The Page metadata 'TranslationsValidateXaml' was renamed to 'RunicTranslationsValidateXaml'." />
    <Error Condition="'@(ApplicationDefinition->HasMetadata('TranslationsValidateXaml'))' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The ApplicationDefinition metadata 'TranslationsValidateXaml' was renamed to 'RunicTranslationsValidateXaml'." />
    <Error Condition="'@(RunicTranslationXaml->HasMetadata('TranslationsValidateXaml'))' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The RunicTranslationXaml metadata 'TranslationsValidateXaml' was renamed to 'RunicTranslationsValidateXaml'." />
    <Error Condition="'$(TranslationsEmitTypeScript)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsEmitTypeScript' was removed: Runic Translations has no TypeScript emitter; RunicTranslationsEmitEsm writes the ESM package with its type declarations. Delete the property." />
    <Error Condition="'$(TranslationsEmitTemplateManifest)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsEmitTemplateManifest' was removed: Runic Translations has no template manifest output. Delete the property." />
    <Error Condition="'$(TranslationsEmitCpp)' != ''" Code="RTR0086" HelpKeyword="RTR0086" Text="The MSBuild property 'TranslationsEmitCpp' was removed: Runic Translations does not generate C++ (C++ is planned for 2.0). Delete the property." />
  </Target>

  <!-- A Runic project marker is the single declaration; its locale documents are discovered beside the declared marker. -->
  <ItemGroup Condition="'@(RunicTranslationProject)' == '' and Exists('$(MSBuildProjectDirectory)\translations\runic.json')">
    <RunicTranslationProject Include="$(MSBuildProjectDirectory)\translations\runic.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Full paths, as discovery reports the sources: a project outside this directory, such as
         ../Frontend/translations/runic.json, then contains its sources (RTR0052 otherwise). -->
    <AdditionalFiles Include="@(RunicTranslationProject->'%(FullPath)')" RunicTranslationKind="Project" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="RunicTranslationKind" />
  </ItemGroup>

  <!-- At execution time the declared project items exist and transformed wildcard
       strings can be expanded by a fresh Include. Evaluation-time transforms retain
       wildcard characters literally. Run before compiler editorconfig generation. -->
  <Target Name="_RunicTranslationsDiscoverTranslationSources"
          BeforeTargets="PrepareForBuild;GenerateMSBuildEditorConfigFileShouldRun;CoreCompile">
    <PropertyGroup>
      <_TranslationsSourceDiscoveryGlobs>@(RunicTranslationProject->'%(RootDir)%(Directory)**/*')</_TranslationsSourceDiscoveryGlobs>
    </PropertyGroup>
    <Runic.Translations.Build.Rmf2SourceDiscovery Projects="@(RunicTranslationProject)" Condition="'@(RunicTranslationProject)' != '' and Exists('$(_Rmf2DiscoveryAssembly)')">
      <Output TaskParameter="Sources" ItemName="_TranslationsDiscoveredSource" />
    </Runic.Translations.Build.Rmf2SourceDiscovery>
    <ItemGroup Condition="'@(RunicTranslationProject)' != '' and !Exists('$(_Rmf2DiscoveryAssembly)')">
      <_TranslationsDiscoveredSource Include="$(_TranslationsSourceDiscoveryGlobs)" />
    </ItemGroup>
    <!-- XAML stays optional. Catalog is an explicit per-file assertion; the project
         default only applies where no statically declared source override applies (RTR0085).
         RunicTranslationsValidateXaml="false" on a Page, ApplicationDefinition or RunicTranslationXaml
         item skips that file, e.g. when its source is inherited from another file or code. -->
    <ItemGroup Condition="'$(RunicTranslationsValidateXaml)' != 'false'">
      <RunicTranslationXaml Include="@(Page);@(ApplicationDefinition)" Exclude="@(RunicTranslationXaml)" Condition="'$(UseWPF)' == 'true'" />
      <RunicTranslationXaml Remove="@(RunicTranslationXaml)" Condition="'%(RunicTranslationXaml.RunicTranslationsValidateXaml)' == 'false'" />
      <AdditionalFiles Include="@(RunicTranslationXaml)" RunicTranslationKind="Xaml"
                       RunicTranslationCatalog="%(RunicTranslationXaml.Catalog)"
                       RunicTranslationDefaultCatalog="$(RunicTranslationsXamlCatalog)" />
      <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="RunicTranslationCatalog" />
      <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="RunicTranslationDefaultCatalog" />
    </ItemGroup>
    <!-- MSBuild globs are case-sensitive on Linux. Match extensions after discovery
         with MSBuild's case-insensitive string comparison, matching the compiler contract. -->
    <ItemGroup Condition="'@(RunicTranslationMf2)' == ''">
      <RunicTranslationMf2 Include="@(_TranslationsDiscoveredSource)"
                      Condition="'%(_TranslationsDiscoveredSource.Extension)' == '.mf2' or '%(_TranslationsDiscoveredSource.Extension)' == '.rmf2'" />
    </ItemGroup>
    <ItemGroup>
      <AdditionalFiles Include="@(RunicTranslationMf2->'%(FullPath)')" RunicTranslationKind="Mf2" />
    </ItemGroup>
  </Target>

  <!-- Returns this project's catalog declaration and sources, so a project that references it can
       check its XAML against the catalog without generating it again. -->
  <Target Name="RunicTranslationsGetXamlCatalogSources"
          DependsOnTargets="_RunicTranslationsDiscoverTranslationSources"
          Returns="@(_TranslationsXamlCatalogSource)">
    <PropertyGroup>
      <_TranslationsXamlCatalogProject>@(RunicTranslationProject->'%(FullPath)')</_TranslationsXamlCatalogProject>
    </PropertyGroup>
    <ItemGroup Condition="'@(RunicTranslationProject->Count())' == '1'">
      <_TranslationsXamlCatalogSource Include="$(_TranslationsXamlCatalogProject)" RunicTranslationKind="XamlCatalogProject" />
      <_TranslationsXamlCatalogSource Include="@(RunicTranslationMf2->'%(FullPath)')" RunicTranslationKind="XamlCatalogSource"
                                      RunicTranslationProject="$(_TranslationsXamlCatalogProject)" />
    </ItemGroup>
  </Target>

  <!-- XAML can use the catalog of a directly referenced project, for example Views in the WPF
       application and translations beside the ViewModels in a class library. The referenced
       catalogs are only linked to check XAML; their projects generate and report them. -->
  <Target Name="_RunicTranslationsCollectReferencedXamlCatalogs"
          DependsOnTargets="_RunicTranslationsDiscoverTranslationSources;PrepareProjectReferences"
          BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
          Condition="'$(RunicTranslationsValidateXaml)' != 'false' and '$(RunicTranslationsXamlReferencedCatalogs)' != 'false'">
    <PropertyGroup>
      <_TranslationsHasXaml>false</_TranslationsHasXaml>
      <_TranslationsHasXaml Condition="'@(RunicTranslationXaml)' != ''">true</_TranslationsHasXaml>
    </PropertyGroup>
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="RunicTranslationsGetXamlCatalogSources"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             SkipNonexistentTargets="true"
             Condition="'$(_TranslationsHasXaml)' == 'true' and '@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_TranslationsReferencedXamlCatalogSource" />
    </MSBuild>
    <ItemGroup>
      <AdditionalFiles Include="@(_TranslationsReferencedXamlCatalogSource)" />
      <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="RunicTranslationProject" />
    </ItemGroup>
  </Target>

  <Target Name="_RunicTranslationsValidateTranslationSources"
          DependsOnTargets="_RunicTranslationsDiscoverTranslationSources"
          BeforeTargets="CoreCompile;RunicTranslationsGenerateTranslationArtifacts">
    <ItemGroup>
      <_TranslationsCheckedSource Include="@(RunicTranslationProject);@(RunicTranslationMf2)" />
      <_TranslationsCheckedDirectory Include="@(_TranslationsCheckedSource->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Error Condition="Exists('%(_TranslationsCheckedSource.Identity)') and $([MSBuild]::BitwiseAnd($([System.Convert]::ToInt32($([System.IO.File]::GetAttributes('%(_TranslationsCheckedSource.Identity)')))), 1024)) != 0" Code="RTR0020" HelpKeyword="RTR0020"
           Text="Translation source '%(_TranslationsCheckedSource.Identity)' must not be a symbolic link or reparse point." />
    <Error Condition="Exists('%(_TranslationsCheckedDirectory.Identity)') and $([MSBuild]::BitwiseAnd($([System.Convert]::ToInt32($([System.IO.File]::GetAttributes('%(_TranslationsCheckedDirectory.Identity)')))), 1024)) != 0" Code="RTR0020" HelpKeyword="RTR0020"
           Text="Translation source directory '%(_TranslationsCheckedDirectory.Identity)' must not be a symbolic link or reparse point." />
  </Target>

  <Target Name="_RunicTranslationsValidateTranslationsOutputPath">
    <!-- Defer defaults until target execution: some SDKs finalize IntermediateOutputPath late. -->
    <PropertyGroup>
      <RunicTranslationsOutputPath Condition="'$(RunicTranslationsOutputPath)' == '' and '$(RunicTranslationsWebOutputPath)' != ''">$(RunicTranslationsWebOutputPath)</RunicTranslationsOutputPath>
      <RunicTranslationsOutputPath Condition="'$(RunicTranslationsOutputPath)' == ''">$(IntermediateOutputPath)translations</RunicTranslationsOutputPath>
      <RunicTranslationsWebOutputPath Condition="'$(RunicTranslationsWebOutputPath)' == ''">$(RunicTranslationsOutputPath)</RunicTranslationsWebOutputPath>
      <RunicTranslationsOutputStamp Condition="'$(RunicTranslationsOutputStamp)' == ''">$(RunicTranslationsOutputPath)\.generate.stamp</RunicTranslationsOutputStamp>
    </PropertyGroup>
    <Error Condition="'$(IntermediateOutputPath)' == ''" Code="RTR0020" HelpKeyword="RTR0020"
           Text="IntermediateOutputPath must be set before translation artifacts can be generated." />
    <Error Condition="'$(RunicTranslationsOutputPath)' == ''" Code="RTR0020" HelpKeyword="RTR0020"
           Text="RunicTranslationsOutputPath must be set before translation artifacts can be generated." />

    <PropertyGroup>
      <_TranslationsProjectDirectory>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))'))</_TranslationsProjectDirectory>
      <_TranslationsIntermediateRoot>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(_TranslationsProjectDirectory)'))'))</_TranslationsIntermediateRoot>
      <_TranslationsOutputDirectory>$([System.IO.Path]::TrimEndingDirectorySeparator('$([System.IO.Path]::GetFullPath('$(RunicTranslationsOutputPath)', '$(_TranslationsProjectDirectory)'))'))</_TranslationsOutputDirectory>
      <_TranslationsOutputRoot>$([MSBuild]::EnsureTrailingSlash('$(_TranslationsOutputDirectory)'))</_TranslationsOutputRoot>
      <_TranslationsRelativeOutput>$([System.IO.Path]::GetRelativePath('$(_TranslationsIntermediateRoot)', '$(_TranslationsOutputRoot)'))</_TranslationsRelativeOutput>
      <_TranslationsParentPrefix>..$([System.IO.Path]::DirectorySeparatorChar)</_TranslationsParentPrefix>
      <_TranslationsOutputStampPath>$([System.IO.Path]::GetFullPath('$(RunicTranslationsOutputStamp)', '$(_TranslationsProjectDirectory)'))</_TranslationsOutputStampPath>
      <_TranslationsRelativeStamp>$([System.IO.Path]::GetRelativePath('$(_TranslationsOutputRoot)', '$(_TranslationsOutputStampPath)'))</_TranslationsRelativeStamp>
      <_TranslationsGenerationStatePath>$(_TranslationsOutputRoot).generate.inputs</_TranslationsGenerationStatePath>
      <_TranslationsGenerationInventoryPath>$(_TranslationsOutputRoot).generate.outputs</_TranslationsGenerationInventoryPath>
      <_TranslationsResponseFilePath>$(_TranslationsOutputRoot).generate.rsp</_TranslationsResponseFilePath>
      <_TranslationsStagingDirectory>$(_TranslationsOutputRoot).generate.staging</_TranslationsStagingDirectory>
      <_TranslationsStagingRoot>$([MSBuild]::EnsureTrailingSlash('$(_TranslationsStagingDirectory)'))</_TranslationsStagingRoot>
    </PropertyGroup>

    <Error Condition="$([System.IO.Path]::IsPathRooted('$(_TranslationsRelativeOutput)')) or '$(_TranslationsRelativeOutput)' == '.' or '$(_TranslationsRelativeOutput)' == '..' or $([System.String]::Copy('$(_TranslationsRelativeOutput)').StartsWith('$(_TranslationsParentPrefix)'))" Code="RTR0020" HelpKeyword="RTR0020"
           Text="RunicTranslationsOutputPath '$(_TranslationsOutputRoot)' must resolve beneath IntermediateOutputPath '$(_TranslationsIntermediateRoot)'." />
    <Error Condition="$([System.IO.Path]::IsPathRooted('$(_TranslationsRelativeStamp)')) or '$(_TranslationsRelativeStamp)' == '.' or '$(_TranslationsRelativeStamp)' == '..' or $([System.String]::Copy('$(_TranslationsRelativeStamp)').StartsWith('$(_TranslationsParentPrefix)'))" Code="RTR0020" HelpKeyword="RTR0020"
           Text="RunicTranslationsOutputStamp '$(_TranslationsOutputStampPath)' must resolve beneath RunicTranslationsOutputPath '$(_TranslationsOutputRoot)'." />
    <Error Condition="Exists('$(_TranslationsOutputDirectory)') and $([MSBuild]::BitwiseAnd($([System.Convert]::ToInt32($([System.IO.File]::GetAttributes('$(_TranslationsOutputDirectory)')))), 1024)) != 0" Code="RTR0020" HelpKeyword="RTR0020"
           Text="RunicTranslationsOutputPath '$(_TranslationsOutputDirectory)' must not be a symbolic link, junction, or other reparse point." />
    <Error Condition="Exists('$(_TranslationsStagingDirectory)') and $([MSBuild]::BitwiseAnd($([System.Convert]::ToInt32($([System.IO.File]::GetAttributes('$(_TranslationsStagingDirectory)')))), 1024)) != 0" Code="RTR0020" HelpKeyword="RTR0020"
           Text="The private translation staging directory must not be a symbolic link, junction, or other reparse point." />
  </Target>

  <Target Name="_RunicTranslationsReadAndValidateTranslationsInventory"
          DependsOnTargets="_RunicTranslationsValidateTranslationsOutputPath">
    <ReadLinesFromFile File="$(_TranslationsGenerationInventoryPath)"
                       Condition="Exists('$(_TranslationsGenerationInventoryPath)')">
      <Output TaskParameter="Lines" ItemName="_TranslationsOwnedInventoryEntry" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_TranslationsOwnedInventoryEntry Update="@(_TranslationsOwnedInventoryEntry)">
        <_OwnedFullPath>$([System.IO.Path]::GetFullPath('%(Identity)', '$(_TranslationsOutputRoot)'))</_OwnedFullPath>
        <_OwnedRelativePath>$([System.IO.Path]::GetRelativePath('$(_TranslationsOutputRoot)', '$([System.IO.Path]::GetFullPath('%(Identity)', '$(_TranslationsOutputRoot)'))'))</_OwnedRelativePath>
      </_TranslationsOwnedInventoryEntry>
      <!-- Permit nested ESM modules while rejecting every path outside the owned root. -->
      <_TranslationsUnsafeInventoryEntry Include="@(_TranslationsOwnedInventoryEntry)"
                                          Condition="'%(_OwnedRelativePath)' == '.' or '%(_OwnedRelativePath)' == '..' or $([System.IO.Path]::IsPathRooted('%(_OwnedRelativePath)')) or $([System.String]::Copy('%(_OwnedRelativePath)').StartsWith('$(_TranslationsParentPrefix)'))" />
    </ItemGroup>
    <Error Condition="'@(_TranslationsUnsafeInventoryEntry)' != ''" Code="RTR0020" HelpKeyword="RTR0020"
           Text="The translation output inventory contains a path that is not a direct child of RunicTranslationsOutputPath; the operation stopped before deleting files." />
  </Target>

  <Target Name="_RunicTranslationsPrepareTranslationsGeneration"
          DependsOnTargets="_RunicTranslationsDiscoverTranslationSources;_RunicTranslationsReadAndValidateTranslationsInventory">
    <MakeDir Directories="$(_TranslationsOutputDirectory)" />
    <RemoveDir Directories="$(_TranslationsStagingDirectory)"
               Condition="Exists('$(_TranslationsStagingDirectory)')" />
    <ReadLinesFromFile File="$(_TranslationsGenerationStatePath)"
                       Condition="Exists('$(_TranslationsGenerationStatePath)')">
      <Output TaskParameter="Lines" ItemName="_TranslationsExistingStateLine" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <_TranslationsEmitArguments></_TranslationsEmitArguments>
      <_TranslationsEmitArguments Condition="'$(RunicTranslationsEmitJson)' == 'true'">$(_TranslationsEmitArguments) --emit-json</_TranslationsEmitArguments>
      <_TranslationsEmitArguments Condition="'$(RunicTranslationsEmitEsm)' == 'true'">$(_TranslationsEmitArguments) --emit-esm</_TranslationsEmitArguments>
      <_TranslationsEmitArguments Condition="'$(RunicTranslationsGenerateOnBuild)' == 'true' and '$(_TranslationsEmitAny)' != 'true'"> --emit-json --emit-esm</_TranslationsEmitArguments>
    </PropertyGroup>
    <ItemGroup>
      <_TranslationsDesiredStateLine Include="tool-command=$(RunicTranslationsToolCommand)" />
      <_TranslationsDesiredStateLine Include="emit-arguments=$(_TranslationsEmitArguments)" />
      <_TranslationsDesiredStateLine Include="additional-arguments=$(RunicTranslationsToolAdditionalArguments)" />
      <_TranslationsDesiredStateLine Include="output=$(_TranslationsOutputDirectory)" />
      <_TranslationsDesiredStateLine Include="@(RunicTranslationProject->'project=%(FullPath)')" />
      <_TranslationsDesiredStateLine Include="@(RunicTranslationMf2->'mf2=%(FullPath)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_TranslationsGenerationStatePath)"
                      Lines="@(_TranslationsDesiredStateLine)"
                      Overwrite="true"
                      Encoding="UTF-8"
                      Condition="'@(_TranslationsExistingStateLine, '|')' != '@(_TranslationsDesiredStateLine, '|')'" />
    <ReadLinesFromFile File="$(_TranslationsResponseFilePath)"
                       Condition="Exists('$(_TranslationsResponseFilePath)')">
      <Output TaskParameter="Lines" ItemName="_TranslationsExistingResponseLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_TranslationsDesiredResponseLine Include="generate" />
      <_TranslationsDesiredResponseLine Include="--project" />
      <_TranslationsDesiredResponseLine Include="@(RunicTranslationProject->'&quot;%(FullPath)&quot;')" />
      <_TranslationsDesiredResponseLine Include="--output" />
      <_TranslationsDesiredResponseLine Include="&quot;$(_TranslationsStagingDirectory)&quot;" />
      <_TranslationsDesiredResponseLine Include="--emit-json" Condition="'$(RunicTranslationsEmitJson)' == 'true' or ('$(RunicTranslationsGenerateOnBuild)' == 'true' and '$(_TranslationsEmitAny)' != 'true')" />
      <_TranslationsDesiredResponseLine Include="--emit-esm" Condition="'$(RunicTranslationsEmitEsm)' == 'true' or ('$(RunicTranslationsGenerateOnBuild)' == 'true' and '$(_TranslationsEmitAny)' != 'true')" />
      <_TranslationsDesiredResponseLine Include="$(RunicTranslationsToolAdditionalArguments)" Condition="'$(RunicTranslationsToolAdditionalArguments)' != ''" />
      <_TranslationsMissingArtifact Include="@(_TranslationsOwnedInventoryEntry)"
                                     Condition="!Exists('%(_OwnedFullPath)')" />
      <_TranslationsExistingArtifact Include="@(_TranslationsOwnedInventoryEntry)"
                                      Condition="Exists('%(_OwnedFullPath)')" />
      <FileWrites Include="$(_TranslationsGenerationStatePath);$(_TranslationsGenerationInventoryPath);$(_TranslationsResponseFilePath)" />
    </ItemGroup>
    <WriteLinesToFile File="$(_TranslationsResponseFilePath)"
                      Lines="@(_TranslationsDesiredResponseLine)"
                      Overwrite="true"
                      Encoding="UTF-8"
                      Condition="'@(_TranslationsExistingResponseLine, '|')' != '@(_TranslationsDesiredResponseLine, '|')'" />
    <Delete Files="$(_TranslationsOutputStampPath)"
            Condition="'@(_TranslationsMissingArtifact)' != '' or !Exists('$(_TranslationsGenerationInventoryPath)')" />
  </Target>

  <Target Name="RunicTranslationsGenerateTranslationArtifacts"
          BeforeTargets="BeforeCompile"
          DependsOnTargets="_RunicTranslationsPrepareTranslationsGeneration;_RunicTranslationsGenerateTranslationArtifactsCore"
          Condition="'$(_TranslationsGenerationEnabled)' == 'true' and '@(RunicTranslationProject)' != ''" />

  <!-- This target is reached only after deferred path defaults and generation state exist. -->
  <Target Name="_RunicTranslationsGenerateTranslationArtifactsCore"
          Inputs="@(RunicTranslationProject);@(RunicTranslationMf2);@(RunicTranslationsToolInput);@(_TranslationsExistingArtifact);$(MSBuildProjectFullPath);$(_TranslationsBuildTargetsPath);$(_TranslationsGenerationStatePath);$(_TranslationsResponseFilePath)"
          Outputs="$(RunicTranslationsOutputStamp)">
    <Error Condition="'@(RunicTranslationProject->Count())' &gt; '1'" Code="RTR0002" HelpKeyword="RTR0002"
           Text="At most one RunicTranslationProject item is supported." />

    <!-- In a C# build the source generator reports the same compilation diagnostics, with their
         help links, during CoreCompile. The tool then omits them so each appears once, and a
         compilation failure (exit code 2) is left to CoreCompile instead of failing here as MSB3073. -->
    <PropertyGroup>
      <_TranslationsGeneratorReportsDiagnostics>false</_TranslationsGeneratorReportsDiagnostics>
      <_TranslationsGeneratorReportsDiagnostics Condition="'$(Language)' == 'C#' and '@(Analyzer->AnyHaveMetadataValue('Filename', 'Runic.Translations.Generator'))' == 'true'">true</_TranslationsGeneratorReportsDiagnostics>
      <_TranslationsToolEnvironment Condition="'$(_TranslationsGeneratorReportsDiagnostics)' == 'true'">RUNIC_TRANSLATIONS_OMIT_SOURCE_DIAGNOSTICS=true</_TranslationsToolEnvironment>
      <_TranslationsToolExitCode>0</_TranslationsToolExitCode>
    </PropertyGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="$(RunicTranslationsToolCommand) &quot;@$(_TranslationsResponseFilePath)&quot;"
          EnvironmentVariables="$(_TranslationsToolEnvironment)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_TranslationsToolExitCode" />
      <Output TaskParameter="ConsoleOutput" ItemName="_TranslationsToolOutputLine" />
    </Exec>
    <!-- Exit code 2 means translation diagnostics: either already logged as canonical errors, or
         left to the source generator. Anything else gets one error instead of MSB3073. -->
    <PropertyGroup>
      <_TranslationsToolReportedError Condition="$([System.String]::Copy('%(_TranslationsToolOutputLine.Identity)').Contains(': error '))">true</_TranslationsToolReportedError>
    </PropertyGroup>
    <Error Condition="'$(_TranslationsToolExitCode)' != '0' and !('$(_TranslationsToolExitCode)' == '2' and ('$(_TranslationsGeneratorReportsDiagnostics)' == 'true' or '$(_TranslationsToolReportedError)' == 'true'))"
           Text="The Runic Translations tool exited with code $(_TranslationsToolExitCode)." />
    <ItemGroup Condition="'$(_TranslationsToolExitCode)' == '0'">
      <_TranslationsStagedArtifact Include="$(_TranslationsStagingRoot)**\*" />
      <_TranslationsGeneratedArtifact Include="@(_TranslationsStagedArtifact->'$(_TranslationsOutputRoot)%(RecursiveDir)%(Filename)%(Extension)')" />
      <_TranslationsStaleArtifact Include="@(_TranslationsOwnedInventoryEntry->'%(_OwnedFullPath)')" />
      <_TranslationsStaleArtifact Remove="@(_TranslationsGeneratedArtifact)" />
    </ItemGroup>
    <!-- Same-volume per-file moves replace current names before stale owned names are deleted. -->
    <Move Condition="'$(_TranslationsToolExitCode)' == '0'"
          SourceFiles="@(_TranslationsStagedArtifact)"
          DestinationFiles="@(_TranslationsGeneratedArtifact)"
          OverwriteReadOnlyFiles="false" />
    <Delete Files="@(_TranslationsStaleArtifact)" Condition="'$(_TranslationsToolExitCode)' == '0'" />
    <WriteLinesToFile Condition="'$(_TranslationsToolExitCode)' == '0'"
                      File="$(_TranslationsGenerationInventoryPath)"
                      Lines="@(_TranslationsGeneratedArtifact->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Encoding="UTF-8" />
    <RemoveDir Directories="$(_TranslationsStagingDirectory)" />
    <Touch Condition="'$(_TranslationsToolExitCode)' == '0'" Files="$(_TranslationsOutputStampPath)" AlwaysCreate="true" />
    <ItemGroup Condition="'$(_TranslationsToolExitCode)' == '0'">
      <FileWrites Include="$(_TranslationsOutputStampPath);$(_TranslationsGenerationInventoryPath);$(_TranslationsResponseFilePath);@(_TranslationsGeneratedArtifact)" />
    </ItemGroup>
  </Target>

  <!-- Backstop: CoreCompile succeeded although the tool reported translation errors it left to the
       source generator, so nothing else would fail the build. -->
  <Target Name="_RunicTranslationsVerifyDeferredFailure"
          AfterTargets="CoreCompile"
          Condition="'$(_TranslationsToolExitCode)' == '2' and '$(_TranslationsGeneratorReportsDiagnostics)' == 'true'">
    <Error Text="The Runic Translations tool reported translation errors; run 'runic-translations validate --project @(RunicTranslationProject->'%(RootDir)%(Directory)')' for details." />
  </Target>

  <Target Name="RunicTranslationsCollectTranslationArtifacts"
          AfterTargets="RunicTranslationsGenerateTranslationArtifacts"
          Condition="'$(_TranslationsGenerationEnabled)' == 'true'">
    <ItemGroup>
      <_TranslationsCurrentArtifact Include="@(_TranslationsExistingArtifact)"
                                     Condition="'@(_TranslationsGeneratedArtifact)' == '' and Exists('%(_TranslationsExistingArtifact.Identity)')" />
      <_TranslationsCurrentArtifact Include="@(_TranslationsGeneratedArtifact)"
                                     Condition="Exists('%(_TranslationsGeneratedArtifact.Identity)')" />
      <RunicTranslationsGeneratedFile Include="@(_TranslationsCurrentArtifact)" />
    </ItemGroup>
  </Target>

  <Target Name="RunicTranslationsCleanTranslationArtifacts"
          BeforeTargets="CoreClean"
          DependsOnTargets="_RunicTranslationsReadAndValidateTranslationsInventory">
    <Delete Files="@(_TranslationsOwnedInventoryEntry->'%(_OwnedFullPath)')" />
    <Delete Files="$(_TranslationsOutputStampPath);$(_TranslationsGenerationStatePath);$(_TranslationsGenerationInventoryPath);$(_TranslationsResponseFilePath)" />
    <RemoveDir Directories="$(_TranslationsStagingDirectory)"
               Condition="Exists('$(_TranslationsStagingDirectory)')" />
    <ItemGroup>
      <_TranslationsRemainingOutput Include="$(_TranslationsOutputRoot)**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(_TranslationsOutputDirectory)"
               Condition="'@(_TranslationsRemainingOutput)' == ''" />
  </Target>
</Project>
