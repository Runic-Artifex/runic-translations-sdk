<Project>
  <!-- Version rule: code generated by release N runs on runtime N or later within the same minor before 1.0 and within
       the same major from 1.0. A packed library's Runic.Translations dependency therefore gets the range
       [N, next minor-0) before 1.0, for example [0.9.0, 0.10.0-0), and [N, next major-0) from 1.0; the -0 bound keeps
       the next breaking release's previews out as well. NuGet takes ranges from the restore output, which a package's
       build files join only from the second restore on, so the packed .nuspec (in the .nupkg and .snupkg) is updated
       after it is generated. A multi-targeted library generates its .nuspec in the outer build, which imports this
       file through buildMultiTargeting. RunicTranslationsStampRuntimeRange=false keeps the open range. -->
  <PropertyGroup>
    <_RunicTranslationsPackTargetsImported>true</_RunicTranslationsPackTargetsImported>
    <_RunicTranslationsPackTaskAssembly>$(MSBuildThisFileDirectory)../tools/net10.0/Runic.Translations.Build.dll</_RunicTranslationsPackTaskAssembly>
    <_RunicTranslationsPackTaskAssembly Condition="!Exists('$(_RunicTranslationsPackTaskAssembly)')">$(MSBuildThisFileDirectory)../bin/$(Configuration)/net10.0/Runic.Translations.Build.dll</_RunicTranslationsPackTaskAssembly>
  </PropertyGroup>
  <UsingTask TaskName="Runic.Translations.Build.RuntimeDependencyRange" AssemblyFile="$(_RunicTranslationsPackTaskAssembly)" Condition="Exists('$(_RunicTranslationsPackTaskAssembly)')" />

  <Target Name="_RunicTranslationsStampRuntimeRange"
          AfterTargets="GenerateNuspec"
          Condition="'$(RunicTranslationsStampRuntimeRange)' != 'false' and Exists('$(_RunicTranslationsPackTaskAssembly)')">
    <Runic.Translations.Build.RuntimeDependencyRange Packages="@(NuGetPackOutput)" />
  </Target>
</Project>
