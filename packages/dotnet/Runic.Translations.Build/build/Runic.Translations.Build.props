<Project>
  <PropertyGroup>
    <!-- Artifact generation is opt-in. Mapping declared inputs to AdditionalFiles is always enabled. -->
    <RunicTranslationsGenerateOnBuild Condition="'$(RunicTranslationsGenerateOnBuild)' == ''">false</RunicTranslationsGenerateOnBuild>
    <RunicTranslationsEmitJson Condition="'$(RunicTranslationsEmitJson)' == ''">false</RunicTranslationsEmitJson>
    <RunicTranslationsEmitEsm Condition="'$(RunicTranslationsEmitEsm)' == ''">false</RunicTranslationsEmitEsm>

    <!-- Keep the launcher replaceable for local tools, pinned tool manifests, and package tests. -->
    <RunicTranslationsToolCommand Condition="'$(RunicTranslationsToolCommand)' == ''">dotnet tool run runic-translations --</RunicTranslationsToolCommand>
    <RunicTranslationsToolAdditionalArguments Condition="'$(RunicTranslationsToolAdditionalArguments)' == ''"></RunicTranslationsToolAdditionalArguments>

    <_RunicTranslationsBuildPropsImported>true</_RunicTranslationsBuildPropsImported>
  </PropertyGroup>

  <!-- dotnet tool run resolves manifests from the project directory upward, usually at the repository root. -->
  <PropertyGroup>
    <_TranslationsToolManifestDirectory>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', '.config/dotnet-tools.json'))</_TranslationsToolManifestDirectory>
    <_TranslationsBareToolManifestDirectory>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildProjectDirectory)', 'dotnet-tools.json'))</_TranslationsBareToolManifestDirectory>
  </PropertyGroup>

  <ItemGroup>
    <RunicTranslationsToolInput Include="$(_TranslationsToolManifestDirectory)\.config\dotnet-tools.json"
                           Condition="'$(_TranslationsToolManifestDirectory)' != ''" />
    <RunicTranslationsToolInput Include="$(_TranslationsBareToolManifestDirectory)\dotnet-tools.json"
                           Condition="'$(_TranslationsBareToolManifestDirectory)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Runic.Translations.Compiler.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Runic.Translations.Compiler.dll')" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Runic.Translations.Generator.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)..\analyzers\dotnet\cs\Runic.Translations.Generator.dll')" />
  </ItemGroup>
</Project>
