<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsGeneratorTargetFramework)</TargetFramework>
    <AssemblyName>Runic.Translations.Build</AssemblyName>
    <RootNamespace>Runic.Translations.Build</RootNamespace>
    <PackageId>Runic.Translations.Build</PackageId>
    <Description>Deterministic MSBuild integration for Runic.Translations translation artifacts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IsPackable>true</IsPackable>
    <!-- A build-time package: a library that references it keeps it out of its own package's dependencies. -->
    <DevelopmentDependency>true</DevelopmentDependency>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);BundleTranslationAnalyzers</TargetsForTfmSpecificContentInPackage>
    <!-- Compiles the linked PathContainment into this namespace: source discovery must not load the compiler. -->
    <DefineConstants>$(DefineConstants);RUNIC_TRANSLATIONS_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
    <Compile Include="../../../tools/Runic.Translations.Compiler/PathContainment.cs" Link="Shared/PathContainment.cs" />
    <!-- The catalog formats a package may ship (runic/, rax/), read by source discovery without loading the compiler. -->
    <Compile Include="../../../tools/Runic.Translations.Compiler/TranslationCatalogFormats.cs" Link="Shared/TranslationCatalogFormats.cs" />
    <!-- The CLDR subset task (CldrLocaleSubset) resolves locales as the runtime does, without loading the compiler. -->
    <Compile Include="../Runic.Translations/Formatting/CldrLocales.cs" Link="Cldr/CldrLocales.cs" />
    <Compile Include="../Runic.Translations/Formatting/GeneratedLocaleTables.cs" Link="Cldr/GeneratedLocaleTables.cs" />
    <ProjectReference Include="..\..\..\tools\Runic.Translations.Compiler\Runic.Translations.Compiler.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Runic.Translations.Generator\Runic.Translations.Generator.csproj" PrivateAssets="all" />
    <None Include="../../../specs/translations/THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="build\Runic.Translations.Build.props"
          Pack="true"
          PackagePath="build\Runic.Translations.Build.props" />
    <None Update="build\Runic.Translations.Build.targets"
          Pack="true"
          PackagePath="build\Runic.Translations.Build.targets" />
    <None Update="build\Runic.Translations.Build.Pack.targets"
          Pack="true"
          PackagePath="build\Runic.Translations.Build.Pack.targets" />
    <None Update="build\Runic.Translations.Build.Locales.targets"
          Pack="true"
          PackagePath="build\Runic.Translations.Build.Locales.targets" />
    <!-- The old-name guards (D079.11), generated from eng/rename/old-names.json. -->
    <None Update="build\Runic.Translations.RenamedNames.targets"
          Pack="true"
          PackagePath="build\Runic.Translations.RenamedNames.targets" />
    <None Update="buildMultiTargeting\Runic.Translations.Build.targets"
          Pack="true"
          PackagePath="buildMultiTargeting\Runic.Translations.Build.targets" />
  </ItemGroup>

  <Target Name="BuildTranslationAnalyzers" BeforeTargets="BundleTranslationAnalyzers" DependsOnTargets="ResolveProjectReferences" Condition="'$(NoBuild)' != 'true'" />
  <Target Name="BundleTranslationAnalyzers">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)Runic.Translations.Build.dll" PackagePath="tools/net10.0" />
      <TfmSpecificPackageFile Include="$(OutputPath)Runic.Translations.Generator.dll"
                              PackagePath="analyzers/dotnet/cs" />
      <!-- Shipped once: the packing task (RunicTranslationsPackCatalog) in tools/net10.0 loads it from here. -->
      <TfmSpecificPackageFile Include="$(OutputPath)Runic.Translations.Compiler.dll"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
  <Import Project="../../../eng/build/translations.targets" />
</Project>
