<linker>
  <!-- TranslationHotReload.SupportedOverride is a test hook. A trimmed or NativeAOT publish removes it unless it sets the
       Runic.Translations.HotReloadTestOverride switch to true, so TranslationHotReload.IsSupported folds to
       MetadataUpdater.IsSupported, which the SDK turns off there, and the trimmer drops Hot Reload's tracking and the
       reflection it needs. featuredefault applies the stub when the switch is not set at all. -->
  <assembly fullname="Runic.Translations" feature="Runic.Translations.HotReloadTestOverride" featurevalue="false" featuredefault="true">
    <type fullname="Runic.Translations.TranslationHotReload">
      <method signature="System.Boolean get_IsOverrideSupported()" body="stub" value="false" />
    </type>
  </assembly>
  <!-- An application that builds with RunicTranslationsCldrSubset embeds the CLDR data of its catalogs' languages and sets
       the Runic.Translations.CldrSubset switch (Runic.Translations.Build.targets); its trimmed or NativeAOT publish then
       drops the full data, about 52 KB. Every other trimmed or NativeAOT publish folds GeneratedLocaleData.IsSubset to
       false (featuredefault: the switch is not set at all) and drops the subset code. -->
  <assembly fullname="Runic.Translations" feature="Runic.Translations.CldrSubset" featurevalue="true">
    <resource name="Runic.Translations.GeneratedLocaleData.bin" action="remove" />
    <type fullname="Runic.Translations.GeneratedLocaleData">
      <method signature="System.Boolean get_IsSubset()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Runic.Translations" feature="Runic.Translations.CldrSubset" featurevalue="false" featuredefault="true">
    <type fullname="Runic.Translations.GeneratedLocaleData">
      <method signature="System.Boolean get_IsSubset()" body="stub" value="false" />
    </type>
  </assembly>
</linker>
