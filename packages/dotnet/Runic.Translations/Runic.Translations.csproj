<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsCompatibilityTargetFramework)</TargetFramework>
    <AssemblyName>Runic.Translations</AssemblyName>
    <RootNamespace>Runic.Translations</RootNamespace>
    <RunicTranslationsShippingProject>true</RunicTranslationsShippingProject>
    <!-- Packed under lib/; its public API is tracked in PublicAPI.*.txt. -->
    <RunicTrackPublicApi>true</RunicTrackPublicApi>
    <Description>Runtime contracts for compiled Runic Translations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- These identifiers are fixed by the portable v1 source/runtime contract. -->
    <NoWarn>$(NoWarn);CA1716;CA1720</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Checks the generated CLDR selectors against every pinned rule sample. -->
    <InternalsVisibleTo Include="Runic.Translations.Runtime.Tests" />
    <!-- The transport conformance corpus still writes version 1 cases. -->
    <InternalsVisibleTo Include="Runic.Translations.Compiler.Tests" />
    <!-- The formatting preview (eng/translations/Rmf2Preview.cs, compiled into both) formats with a requested locale,
         the catalog's bidi isolation and a preview time zone through the runtime's internal entry points. -->
    <InternalsVisibleTo Include="Runic.Translations.Editor" />
    <InternalsVisibleTo Include="dotnet-runic-translations" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned CLDR list patterns and relative time, deflated (eng/generate-cldr.mjs). -->
    <EmbeddedResource Include="Formatting/GeneratedLocaleData.bin" LogicalName="Runic.Translations.GeneratedLocaleData.bin" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\specs\translations\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\..\specs\translations\cldr\LICENSE" Pack="true" PackagePath="licenses" />
  </ItemGroup>
  <Import Project="../../../eng/build/translations.targets" />
</Project>
