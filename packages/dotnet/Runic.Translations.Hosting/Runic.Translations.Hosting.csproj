<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <TargetFramework>$(RunicTranslationsCompatibilityTargetFramework)</TargetFramework>
    <AssemblyName>Runic.Translations.Hosting</AssemblyName>
    <RootNamespace>Runic.Translations.Hosting</RootNamespace>
    <PackageId>Runic.Translations.Hosting</PackageId>
    <RunicTranslationsShippingProject>true</RunicTranslationsShippingProject>
    <!-- Packed under lib/; its public API is tracked in PublicAPI.*.txt. -->
    <RunicTrackPublicApi>true</RunicTrackPublicApi>
    <Description>Registers a shared Runic Translations context, its catalogs and overlays with Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>runic-artifex;i18n;localization;dependency-injection;dotnet;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="../Runic.Translations/Runic.Translations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <!-- Bounds the Runic.Translations dependency to this release's minor, [N, next minor-0.0), as for the adapter and every
       packed library (D061.16): a mismatched Translations runtime is then NU1608 at restore instead of a runtime break. -->
  <Import Project="../Runic.Translations.Build/build/Runic.Translations.Build.Pack.targets" />
  <Import Project="../../../eng/build/translations.targets" />
</Project>
