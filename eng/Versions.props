<Project><PropertyGroup><RunicTranslationsVersion>0.10.0</RunicTranslationsVersion><!-- Last published release; package validation compares candidates with it. --><RunicTranslationsPackageValidationBaselineVersion>0.9.1</RunicTranslationsPackageValidationBaselineVersion><RunicSdkVersion>$(RunicTranslationsVersion)</RunicSdkVersion><!-- The runic-sdk release the Translations Editor is built on; its CS-WebUI host package has its own prerelease version. --><RunicSdkDependencyVersion>0.17.1</RunicSdkDependencyVersion><RunicSdkCsWebUiDependencyVersion>0.17.1-preview.1</RunicSdkCsWebUiDependencyVersion><!-- The tested Runic Command Line release. Restore uses it as the floor; when a package is packed, Runic.Translations.Build's
     RuntimeDependencyRange gives the Runic.CommandLine dependency the -0.0 upper bound of every cross-repository range
     (D061.13), [0.12.0, 0.13.0-0.0) before 1.0, after NuGet generated the .nuspec. A -0.0 bound written here would make
     NuGet's pack see a prerelease dependency of a stable package (NU5104, an error in Verification builds). Lockstep:
     each Translations minor supports exactly one Command Line minor (docs/guides/translations/command-line.md). --><RunicCommandLineVersion>0.12.0</RunicCommandLineVersion><Version Condition="'$(Version)' == ''">$(RunicTranslationsVersion)</Version><PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicTranslationsVersion)</PackageVersion></PropertyGroup></Project>
