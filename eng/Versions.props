<Project><PropertyGroup><RunicTranslationsVersion>0.9.0</RunicTranslationsVersion><!-- Last published release; package validation compares candidates with it. --><RunicTranslationsPackageValidationBaselineVersion>0.8.0</RunicTranslationsPackageValidationBaselineVersion><RunicSdkVersion>$(RunicTranslationsVersion)</RunicSdkVersion><!-- The runic-sdk release the Translations Editor is built on; its CS-WebUI host package has its own prerelease version. --><RunicSdkDependencyVersion>0.11.0</RunicSdkDependencyVersion><RunicSdkCsWebUiDependencyVersion>0.11.0-preview.1</RunicSdkCsWebUiDependencyVersion><!-- The tested Runic Command Line release; packages depend on its minor, [0.9.0, 0.10) (D031.3). --><RunicCommandLineVersion>0.9.0</RunicCommandLineVersion><RunicCommandLineVersionRange>[$(RunicCommandLineVersion), 0.10)</RunicCommandLineVersionRange><Version Condition="'$(Version)' == ''">$(RunicTranslationsVersion)</Version><PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicTranslationsVersion)</PackageVersion></PropertyGroup></Project>
