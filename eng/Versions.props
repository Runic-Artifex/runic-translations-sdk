<Project><PropertyGroup><RunicTranslationsVersion>0.10.0</RunicTranslationsVersion><!-- Last published release; package validation compares candidates with it. --><RunicTranslationsPackageValidationBaselineVersion>0.9.1</RunicTranslationsPackageValidationBaselineVersion><RunicSdkVersion>$(RunicTranslationsVersion)</RunicSdkVersion><!-- The runic-sdk release the Translations Editor is built on; its CS-WebUI host package has its own prerelease version. --><RunicSdkDependencyVersion>0.17.1</RunicSdkDependencyVersion><RunicSdkCsWebUiDependencyVersion>0.17.1-preview.1</RunicSdkCsWebUiDependencyVersion><!-- The tested Runic Command Line release. Packages depend on its minor before 1.0 and on its major from 1.0, with the
     -0.0 upper bound of every cross-repository range (D061.13): 0.12.0 gives [0.12.0, 0.13.0-0.0). Lockstep: each
     Translations minor supports exactly one Command Line minor (docs/guides/translations/command-line.md). --><RunicCommandLineVersion>0.12.0</RunicCommandLineVersion><_RunicCommandLineVersionCore>$([System.Text.RegularExpressions.Regex]::Match('$(RunicCommandLineVersion)', '^[0-9]+\.[0-9]+\.[0-9]+').Value)</_RunicCommandLineVersionCore><_RunicCommandLineMajor>$([System.Version]::Parse('$(_RunicCommandLineVersionCore)').Major)</_RunicCommandLineMajor><_RunicCommandLineMinor>$([System.Version]::Parse('$(_RunicCommandLineVersionCore)').Minor)</_RunicCommandLineMinor><RunicCommandLineVersionUpperBound Condition="'$(_RunicCommandLineMajor)' == '0'">0.$([MSBuild]::Add($(_RunicCommandLineMinor), 1)).0-0.0</RunicCommandLineVersionUpperBound><RunicCommandLineVersionUpperBound Condition="'$(_RunicCommandLineMajor)' != '0'">$([MSBuild]::Add($(_RunicCommandLineMajor), 1)).0.0-0.0</RunicCommandLineVersionUpperBound><RunicCommandLineVersionRange>[$(RunicCommandLineVersion), $(RunicCommandLineVersionUpperBound))</RunicCommandLineVersionRange><Version Condition="'$(Version)' == ''">$(RunicTranslationsVersion)</Version><PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicTranslationsVersion)</PackageVersion></PropertyGroup></Project>
