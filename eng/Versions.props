<Project><PropertyGroup><RunicTranslationsVersion>0.7.0-preview.5</RunicTranslationsVersion><!-- Last published release; package validation compares candidates with it. --><RunicTranslationsPackageValidationBaselineVersion>0.7.0-preview.4</RunicTranslationsPackageValidationBaselineVersion><RunicSdkVersion>$(RunicTranslationsVersion)</RunicSdkVersion><RunicSdkDependencyVersion>0.7.0-preview.6</RunicSdkDependencyVersion><!-- The tested Runic Command Line release; packages depend on its minor, [0.9.0, 0.10) (D031.3). --><RunicCommandLineVersion>0.9.0</RunicCommandLineVersion><RunicCommandLineVersionRange>[$(RunicCommandLineVersion), 0.10)</RunicCommandLineVersionRange><Version Condition="'$(Version)' == ''">$(RunicTranslationsVersion)</Version><PackageVersion Condition="'$(PackageVersion)' == ''">$(RunicTranslationsVersion)</PackageVersion></PropertyGroup></Project>
