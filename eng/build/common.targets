<Project><PropertyGroup Condition="'$(RunicPolicyShippingProject)' == 'true'"><IsTrimmable>true</IsTrimmable><IsAotCompatible>true</IsAotCompatible></PropertyGroup><Target Name="ValidateRunicBuildMode" BeforeTargets="PrepareForBuild"><Error Condition="'$(RunicBuildMode)' != 'Development' and '$(RunicBuildMode)' != 'Verification'" Text="$(RunicBuildModeProperty) must be either Development or Verification." /></Target></Project>
