<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds against this repository's sources. An application references the Runic.Translations and
       Runic.Translations.Build packages instead. -->
  <Import Project="../../../eng/build/translations.props" />
  <Import Project="../../../packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- The frontend's catalog: one set of translations for the page and this process. -->
    <TranslationProject Include="../Frontend/translations/runic.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations/Runic.Translations.csproj" />
    <Analyzer Include="../../../packages/dotnet/Runic.Translations.Generator/bin/$(Configuration)/net10.0/Runic.Translations.Compiler.dll" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations.Generator/Runic.Translations.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.targets" />
  <Import Project="../../../eng/build/translations.targets" />
</Project>
