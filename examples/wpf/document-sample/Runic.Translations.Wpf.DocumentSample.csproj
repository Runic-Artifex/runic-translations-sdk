<Project Sdk="Microsoft.NET.Sdk">
  <!-- The interactive WPF document sample (Windows only). It renders the document fixture of the WPF tests. -->
  <Import Project="../../../eng/build/translations.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations.Wpf/Runic.Translations.Wpf.csproj" />
    <Compile Include="../../../tests/dotnet/Runic.Translations.Wpf.Tests/DocumentFixture.cs" Link="DocumentFixture.cs" />
  </ItemGroup>
  <Import Project="../../../eng/build/translations.targets" />
</Project>
