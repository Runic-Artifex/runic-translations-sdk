<Project Sdk="Microsoft.NET.Sdk">
  <!-- Builds against this repository's sources. An application uses the Runic.Translations,
       Runic.Translations.Build and Runic.Translations.CommandLine packages instead. -->
  <Import Project="../../../eng/build/translations.props" />
  <Import Project="../../../packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Runic.CommandLine" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations.CommandLine/Runic.Translations.CommandLine.csproj" />
    <Analyzer Include="../../../packages/dotnet/Runic.Translations.Generator/bin/$(Configuration)/net10.0/Runic.Translations.Compiler.dll" />
    <ProjectReference Include="../../../packages/dotnet/Runic.Translations.Generator/Runic.Translations.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;IlcTreatWarningsAsErrors" />
  </ItemGroup>
  <Import Project="../../../packages/dotnet/Runic.Translations.Build/build/Runic.Translations.Build.targets" />
  <Import Project="../../../eng/build/translations.targets" />
</Project>
