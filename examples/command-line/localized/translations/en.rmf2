# Keyed by the DescriptionKey values in Program.cs. Framework text comes from
# Runic.Translations.CommandLine; override it in translations/overrides/runic-command-line/,
# not here: a message named after a framework key, such as help.usage, has no effect (RTR0107).
commands {
  greet = Greet a person
}
arguments {
  name = Name of the person to greet
}
app {
  greeting =
    .input {$name :string}
    {{Hello {$name}}}
}
