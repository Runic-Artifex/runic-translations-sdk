<Project>
  <Import Project="eng/Versions.props" Condition="'$(RunicSdkVersion)' == ''" />
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally><CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled></PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
    <!-- Build tests check the dependency range with NuGet's own version ordering. -->
    <PackageVersion Include="NuGet.Versioning" Version="7.9.0" />
    <!-- The floor only: the packed range is stamped after pack (eng/Versions.props, RunicCommandLineVersion). -->
    <PackageVersion Include="Runic.CommandLine" Version="$(RunicCommandLineVersion)" />
    <PackageVersion Include="Runic.CommandLine.Spectre" Version="$(RunicCommandLineVersion)" />
    <PackageVersion Include="Runic.Application.Testing" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Application.Views.ReactiveUI" Version="$(RunicSdkDependencyVersion)" />
    <!-- The editor's Runic Desktop host: native windows (GTK 4 and WebKitGTK 6 on Linux, WebView2, WKWebView) and the
         native presentation server. -->
    <PackageVersion Include="Runic.Application.Views.Desktop" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Desktop.Gtk4" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Desktop.NativeServer" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Platform.Linux" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Platform.Linux.Portal" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Platform.Windows" Version="$(RunicSdkDependencyVersion)" />
    <PackageVersion Include="Runic.Platform.MacOS" Version="$(RunicSdkDependencyVersion)" />
    <!-- The editor's spell checker (D074.10, D086.2): a preview package of runic-sdk on a version line of its own,
         outside the 1.0 promise, released with runic-sdk 0.24.0. -->
    <PackageVersion Include="Runic.Spelling" Version="0.24.0-preview.1" />
    <!-- TUnit test projects (see CONTRIBUTING.md); keep TUnit.Core and TUnit.Engine on one version. -->
    <PackageVersion Include="TUnit.Core" Version="1.73.19" />
    <PackageVersion Include="TUnit.Engine" Version="1.73.19" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>
</Project>
